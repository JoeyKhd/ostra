{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "4",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "scripts/generate.ts"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^generate"]
    },
    "lint": {
      "dependsOn": ["generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    }
  }
}
