# syntax=docker/dockerfile:1.7
# The runner image (ADR 0046): the `ostra` CLI, which is a pool runner (`runner`) and, in each
# docker box, its sidecar (`sidecar`). It holds git and git-lfs for the sidecar's checkouts and
# commits on the box's task volume, and no agent: the agent runs in the base image's container.
#
#   docker build -f deploy/Dockerfile.runner -t ostra/runner:0.0.0 .
#
# Written for milestone 1, built on Linux only (ticket 22).

FROM node:24.14.0-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable

FROM base AS prune
WORKDIR /src
COPY . .
RUN pnpm dlx turbo@2.11.13 prune @ostra/runner --docker

FROM base AS build
WORKDIR /app
COPY --from=prune /src/out/json/ ./
RUN pnpm install --frozen-lockfile --prod
COPY --from=prune /src/out/full/ ./

FROM node:24.14.0-bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install --yes --no-install-recommends git git-lfs ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app /app
# The box's task volume is seeded from this folder: owned by the agent's user (uid 1000, `node`).
RUN mkdir -p /task /run/ostra && chown node:node /task
USER node
WORKDIR /task
ENTRYPOINT ["node", "/app/apps/runner/src/main.ts"]
CMD ["runner"]
