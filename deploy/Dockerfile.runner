# syntax=docker/dockerfile:1.7
# The runner image (ADR 0046): the `ostra` CLI, built from apps/runner, which is a pool runner
# (`ostra runner`) and, in each box, its sidecar (`ostra sidecar`). It holds git and git-lfs for
# the sidecar's checkouts and commits on the box's task volume, and no agent: the agent runs in the
# base image's container (its build removes the OpenCode packages @ostra/adapter-opencode
# depends on). `ostra --version` prints the release version; an image runner installs
# no other version (ADR 0034: its tag is the pin).
#
#   pnpm images:build                  (Linux with Docker: all three, tagged with the release)
#   pnpm check:images                  (anywhere: the static checks, packages/deploy-checks)
#
# Every FROM is pinned by digest. Built live in milestone 5's Linux proof job (ticket 35).

FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable

FROM base AS prune
WORKDIR /src
COPY . .
RUN pnpm dlx turbo@2.11.13 prune @ostra/runner --docker

FROM base AS build
WORKDIR /app
COPY --from=prune /src/out/json/ ./
RUN pnpm install --frozen-lockfile --prod
COPY --from=prune /src/out/full/ ./
# THIRD_PARTY_NOTICES (milestone 7's ticket 29): every third-party package this install bundles,
# each with its license and the license and notice files it ships, from pnpm's own report. The
# build fails on a license scripts/known-licenses.ts doesn't know, and on a package the notices miss.
COPY scripts/known-licenses.ts /opt/notices/scripts/
COPY packages/deploy-checks/src/notices.ts packages/deploy-checks/src/notices-main.ts /opt/notices/packages/deploy-checks/src/
# The runner carries no agent: in a box, the agent runs in the base image. @ostra/adapter-opencode
# depends on @opencode/cli for the host executor, so its packages are removed from this install,
# and --without-agent fails the build if any is left.
RUN pnpm licenses list --json --recursive --prod > /tmp/licenses.json   && rm -rf node_modules/.pnpm/@opencode+cli* packages/adapters/adapter-opencode/node_modules/@opencode   && node /opt/notices/packages/deploy-checks/src/notices-main.ts --image runner --pnpm-licenses /tmp/licenses.json      --pnpm-store /app/node_modules/.pnpm --without-agent --out /opt/notices/out/THIRD_PARTY_NOTICES

FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS runtime
RUN apt-get update \
  && apt-get install --yes --no-install-recommends git git-lfs ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app /app
COPY --from=build /opt/notices/out/THIRD_PARTY_NOTICES /usr/share/doc/ostra/THIRD_PARTY_NOTICES
# `ostra` on the PATH: the docker executor runs the sidecar as this image's entrypoint with
# `sidecar`, and the kubernetes executor's pod runs `ostra sidecar`.
RUN printf '#!/bin/sh\nexec node /app/apps/runner/src/main.ts "$@"\n' > /usr/local/bin/ostra \
  && chmod 0755 /usr/local/bin/ostra \
  && mkdir -p /task /run/ostra && chown node:node /task
# The runner reports how it was installed (ADR 0034's pin): from the image, it installs no other version.
ENV OSTRA_INSTALL=image
# The box's task volume is seeded from /task: owned by the agent's user (uid 1000, `node`), which
# the sidecar runs as too.
USER node
WORKDIR /task
ENTRYPOINT ["ostra"]
CMD ["runner"]
