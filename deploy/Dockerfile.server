# syntax=docker/dockerfile:1.7
# The server image (ADR 0046): one entrypoint, `ostra-server web|core|all`. The panel (`web`) and
# core (`core`) run as separate deployments of this image on Kubernetes (deploy/helm/ostra-server);
# `all` runs both, the compose file's default. Built from source with `turbo prune --docker`, so the
# install layer changes only when a package.json or the lockfile does.
#
#   pnpm images:build                  (Linux with Docker: all three, tagged with the release)
#   pnpm check:images                  (anywhere: the static checks, packages/deploy-checks)
#
# Every FROM is pinned by digest. Built live in milestone 5's Linux proof job (ticket 35).

FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable

FROM base AS prune
WORKDIR /src
COPY . .
RUN pnpm dlx turbo@2.11.13 prune @ostra/core @ostra/web --docker

FROM base AS build
# OpenSSL before the install: Prisma's install picks its schema engine by the OpenSSL it finds, and
# on the slim image, which has none, it takes the OpenSSL 1.1 build, which bookworm can't load.
RUN apt-get update \
  && apt-get install --yes --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=prune /src/out/json/ ./
RUN pnpm install --frozen-lockfile
COPY --from=prune /src/out/full/ ./
# `turbo prune` keeps the packages and the root's package.json, lockfile and turbo.json, not the
# root tsconfig.base.json every package's tsconfig extends, which Prisma's generate and next build
# read (`pnpm check:images` checks it's here).
COPY tsconfig.base.json ./
RUN pnpm --filter @ostra/db generate && pnpm --filter @ostra/web build
# THIRD_PARTY_NOTICES (milestone 7's ticket 29): every third-party package this install bundles,
# each with its license and the license and notice files it ships, from pnpm's own report. The
# build fails on a license scripts/known-licenses.ts doesn't know, and on a package the notices miss.
COPY scripts/known-licenses.ts /opt/notices/scripts/
COPY packages/deploy-checks/src/notices.ts packages/deploy-checks/src/notices-main.ts /opt/notices/packages/deploy-checks/src/
RUN pnpm licenses list --json --recursive > /tmp/licenses.json   && node /opt/notices/packages/deploy-checks/src/notices-main.ts --image server --pnpm-licenses /tmp/licenses.json      --pnpm-store /app/node_modules/.pnpm --out /opt/notices/out/THIRD_PARTY_NOTICES

# The runtime starts node directly, so it needs no pnpm and downloads nothing when it starts.
FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8 AS runtime
# Prisma's schema engine, which runs the migrations when `core` or `all` starts, links OpenSSL.
RUN apt-get update \
  && apt-get install --yes --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production OSTRA_DATA_DIR=/var/lib/ostra
COPY --from=build --chown=node:node /app /app
COPY --from=build /opt/notices/out/THIRD_PARTY_NOTICES /usr/share/doc/ostra/THIRD_PARTY_NOTICES
COPY --chmod=0755 deploy/server-entrypoint.sh /usr/local/bin/ostra-server
RUN mkdir -p /var/lib/ostra && chown node:node /var/lib/ostra
USER node
EXPOSE 3000 8787
# Docker's own check (compose): core's /healthz and the panel, by the process this container runs.
# The Helm chart probes the same addresses itself.
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 CMD ["ostra-server", "health"]
ENTRYPOINT ["ostra-server"]
CMD ["all"]
