        "type": "string",
        "minLength": 1
      }
    },
    "publicUrl": {
      "type": "string"
    },
    "corePublicUrl": {
      "type": "string"
    },
    "database": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
