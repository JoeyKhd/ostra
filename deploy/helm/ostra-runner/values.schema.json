        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "existingSecret",
        "key"
      ],
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]*$"
          }
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nodeWaitMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runtimeClass": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                ]
              }
            },
            "limits": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                ]
              }
            }
          },
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "labels",
        "slots",
        "nodeWaitMinutes",
        "runtimeClass",
        "resources"
      ],
      "additionalProperties": false
    },
    "namespaces": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "boxes": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "builds": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      },
      "required": [
        "create",
        "boxes",
        "builds"
      ],
      "additionalProperties": false
    },
    "egress": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allow"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "object",
          "properties": {
            "addresses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "addresses",
            "port"
          ],
          "additionalProperties": false
        },
        "packageHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "codeHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "registry",
        "packageHosts",
        "codeHosts"
      ],
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClassName": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "size",
        "storageClassName"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "image",
    "imagePullSecrets",
    "boxImage",
    "server",
    "joinToken",
    "runner",
    "namespaces",
    "egress",
    "build",
    "persistence"
  ],
  "additionalProperties": false,
  "title": "ostra-runner values",
  "description": "Generated from packages/deploy-checks/src/helm/values.ts by pnpm check:helm --write-schemas. Don't edit it by hand."
}
