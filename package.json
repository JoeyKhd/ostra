{
  "name": "ostra",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "lint": "turbo run lint && eslint eslint.config.js prettier.config.js vitest.config.ts scripts --max-warnings 0",
    "test": "turbo run test && vitest run",
    "build": "turbo run build",
    "check:licenses": "node scripts/check-licenses.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-unicorn": "80.0.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
