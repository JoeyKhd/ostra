{
  "name": "ostra",
  "version": "0.0.0",
  "private": true,
  "license": "LicenseRef-Sustainable-Use-1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "lint": "turbo run lint && eslint eslint.config.js prettier.config.js vitest.config.ts scripts --max-warnings 0",
    "test": "turbo run test && vitest run --maxWorkers=4",
    "build": "turbo run build",
    "dev": "node scripts/dev.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:proof": "node scripts/check-proof.ts",
    "proof:new": "node scripts/proof-new.ts",
    "format": "prettier --write .",
    "db:dev": "node packages/db/scripts/dev-postgres.ts",
    "db:migrate": "node packages/db/scripts/migrate.ts",
    "db:generate": "node packages/db/scripts/generate.ts",
    "dev:reset": "node packages/db/scripts/reset.ts",
    "dev:seed-member": "node packages/api/scripts/seed-member.ts",
    "dev:mail-sink": "node e2e/dev-tools/src/dev-mail-sink.ts",
    "dev:link-github": "node e2e/dev-tools/src/dev-link-github.ts",
    "e2e:m1": "node e2e/m1-first-pr/src/demo.ts --checks --clean-up",
    "e2e:m2": "node e2e/m2-tickets-in/src/demo.ts --checks",
    "e2e:m3": "node e2e/m3-step-in/src/demo.ts",
    "ostra": "node apps/runner/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-unicorn": "80.0.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
