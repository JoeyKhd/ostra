// ostra's schema (milestone 1, ticket 06). Every entity of context/domain-model.md is here, also
// the ones milestone 1 doesn't write yet, because adding a noun later is a rewrite
// (build-order.md, the v1 cut, rule 1).
//
// Rules this file keeps:
// - Every ostra row carries `organizationId` (ADR 0026). Install-level rows (accounts, sessions,
//   instance settings) are the only exception.
// - Every row inside a project also carries `projectId`, with a composite foreign key
//   `(projectId, organizationId)` to `Project (id, organizationId)`, so a row can't point at
//   another organization's project (spike 9, recommendation 3). Rows inside a task also have a
//   composite key `(taskId, projectId)` to `Task (id, projectId)`.
// - IDs are UUIDv7 text (`@default(uuid(7))`). better-auth's tables keep the IDs better-auth makes.
// - States are enums whose values the domain's unions map to (packages/domain, ticket 07). Check
//   constraints that Prisma can't declare are in the migration's raw SQL, marked `ostra:`.
// - The live-text table is UNLOGGED and lives in its own schema, `ostra_live`, created by raw SQL,
//   so Prisma Migrate never sees it and never drops it (ADR 0035).
//
// Migrations run on other teams' installs: add first, drop or rename in a later release (AGENTS.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// better-auth (1.7.25, Prisma adapter) for the username, organization, device authorization,
// admin and bearer plugins, as spike 9 generated them. ostra's edits are marked `ostra:`.
// ===========================================================================

model User {
  id                 String        @id
  name               String
  email              String
  emailVerified      Boolean       @default(false)
  image              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  // ostra: required, not optional. Every account has a unique username (Q54, F-002).
  username           String
  displayUsername    String?
  role               String?
  banned             Boolean?      @default(false)
  banReason          String?
  banExpires         DateTime?
  /// ostra: the account still has the default password it was seeded with (F-001): its first
  /// sign-in must choose a new one, unless OSTRA_ALLOW_DEFAULT_PASSWORD is on. A better-auth
  /// additional field (`input: false`), so no sign-up or profile update can set it.
  mustChangePassword Boolean       @default(false)
  // ---- milestone 3 ----
  /// ostra: the verified GitHub account (F-119, ADR 0052), from the App's own OAuth. One GitHub
  /// identity per person across organizations, unique per install. No token is kept.
  githubUserId       String?
  githubLogin        String?
  githubLinkedAt     DateTime?
  sessions           AuthSession[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  cliSessions        CliSession[]
  // ---- milestone 4 ----
  resetLinkGrants    ResetLinkGrant[]
  // ---- milestone 7 ----
  /// ostra: the member's theme (F-082): dark, light or the system's. A better-auth additional field
  /// (`input: false`), so only `account.setTheme` writes it.
  theme              ThemePreference @default(dark)

  @@unique([email])
  @@unique([username])
  @@unique([githubUserId], where: raw("\"githubUserId\" IS NOT NULL"), map: "user_github_user_id_unique")
  @@map("user")
}

// ostra: renamed from better-auth's `Session`, which would clash with ostra's own (an agent's
// session). Ticket 30 configures better-auth with `session: { modelName: "authSession" }`.
model AuthSession {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  // ostra: every ostra-owned row carries its organization (ADR 0026).
  auditEntries       AuditEntry[]
  changeNotices      ChangeNotice[]
  connections        Connection[]
  modelProviders     ModelProvider[]
  models             Model[]
  runnerPools        RunnerPool[]
  joinTokens         JoinToken[]
  runners            Runner[]
  runnerPresences    RunnerPresence[]
  agentProfiles      AgentProfile[]
  secrets            Secret[]
  projects           Project[]
  commands           Command[]
  webhookDeliveries  WebhookDelivery[]
  // Milestone 2.
  tickets            Ticket[]
  ticketWrites       TicketWrite[]
  idempotencyRecords IdempotencyRecord[]
  rateBudgets        RateBudget[]
  blobs              Blob[]
  blobUploads        BlobUpload[]
  blobChunks         BlobChunk[]
  oauthStates        OAuthState[]
  setting            OrganizationSetting?
  // Milestone 4.
  budgets            Budget[]
  insightDailies     InsightDaily[]
  insightRun         InsightRun?
  memoryNotes        MemoryNote[]
  memoryProposals    MemoryProposal[]
  // Milestone 4, keys per project (ADR 0065).
  providerListEntries ProviderListEntry[]
  modelChoices        ModelChoice[]
  // Milestone 4, the account mails (ticket 19).
  accountMailDeliveries AccountMailDelivery[]
  // Milestone 5 (F-095, F-120).
  boxSizes              BoxSize[]
  registry              Registry?
  // Milestone 6 (F-012): agent sessions, which may arrive before a project is known.
  agentSessions         AgentSession[]
  agentActivities       AgentActivity[]
  // Milestone 8 (F-145, ADR 0069): the library.
  libraryItems          LibraryItem[]
  librarySources        LibrarySource[]
  librarySuggestions    LibrarySuggestion[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ostra: `admin` or `member` (Q35, F-003), checked in the migration. better-auth's organization
  // plugin is configured with `creatorRole: "admin"` (ticket 30).
  role           String       @default("member")
  createdAt      DateTime
  // ---- milestone 4 (F-002, ADR 0053) ----
  /// Lists of members show `active` ones unless they show history. A removed membership is kept,
  /// so history keeps its name; a pending or removed one makes no scope.
  state             MemberState @default(active)
  removedAt         DateTime?
  /// No foreign key: the admin who removed it, kept by ID.
  removedByMemberId String?

  ownedRunners       Runner[]
  projectMemberships ProjectMember[]
  // ---- milestone 3 ----
  profileAccess           AgentProfileMember[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  cliSessions             CliSession[]
  // ---- milestone 8 (F-142) ----
  previewAccess           PreviewAccessMember[]

  // ostra: one membership per account and organization, not just unlikely twice (spike 9).
  @@unique([organizationId, userId])
  // ostra: the target of composite keys that tie a member to its organization.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  // ---- milestone 4 (F-002, ADR 0053) ----
  /// ostra: the restricted projects it grants, `[{ projectId, role }]`, parsed by the domain's schema.
  projectGrants     Json      @default("[]")
  acceptedAt        DateTime?
  /// The account that accepted it. No foreign key: kept by ID.
  acceptedUserId    String?
  revokedAt         DateTime?
  /// No foreign key: the admin who revoked it, kept by ID.
  revokedByMemberId String?
  /// When the panel last showed its link to the inviter.
  linkShownAt       DateTime?

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model DeviceCode {
  id              String    @id
  deviceCode      String
  userCode        String
  userId          String?
  expiresAt       DateTime
  status          String
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?
  /// ostra, milestone 3 (F-103): what the code signs in, a runner or the `ostra` CLI.
  purpose         DeviceCodePurpose @default(runner)
  /// ostra, milestone 3: the machine's name the CLI sent, for the device page and the CLI session.
  machineName     String?
  /// ostra, milestone 3 (F-103): the organization the approving login session was in, so a CLI session
  /// binds to that organization's member and not to the account's oldest membership. Null until approved.
  organizationId  String?

  @@unique([deviceCode], map: "deviceCode_deviceCode_uidx")
  @@unique([userCode], map: "deviceCode_userCode_uidx")
  @@map("deviceCode")
}

// ===========================================================================
// The install
// ===========================================================================

/// The install's settings: one row, `id = 'instance'`.
model InstanceSetting {
  id                      String    @id @default("instance")
  // Deprecated 2026-11-19: open sign-up is gone (ostra is self-hosted only, ADR 0026 amended), and
  // no code reads or writes these two columns. They stay because installs upgrade on their own
  // schedule (AGENTS.md: add first, drop in a later release); a later release's migration drops
  // them (milestone 4 spec, section 5.3). Don't use them.
  /// Deprecated 2026-11-19, unused: dropped in a later release. Was open account sign-up.
  openSignupAccounts      Boolean   @default(false)
  /// Deprecated 2026-11-19, unused: dropped in a later release. Was open organization sign-up.
  openSignupOrganizations Boolean   @default(false)
  /// Set when the first admin exists: the server never seeds another (F-001).
  firstAdminCreatedAt     DateTime?
  /// Milestone 2 (F-079): how many days histories, archives and blobs are kept after their task
  /// ends, or `null` to keep them while the task exists. Read only when `retentionSetAt` is set.
  retentionDays           Int?
  /// When an admin last saved retention. `null`: none has, so `OSTRA_RETENTION_DAYS` applies;
  /// set: the saved `retentionDays` wins, and `null` there means "keep" (spec section 11, item 11).
  retentionSetAt          DateTime?
  /// Milestone 3 (F-115): how long a needs-you mail waits, or `null` for `OSTRA_EMAIL_DELAY_SECONDS`.
  emailDelaySeconds       Int?
  // ---- milestone 8 (ticket 26, F-144): the preview domain's last check, for Instance › Previews ----
  /// The `OSTRA_PREVIEW_DOMAIN` the last check ran on: a result for another domain is no result.
  previewCheckDomain      String?
  /// The check's answer (`previewDomainCheckSchema`'s `checked` state), read back through it.
  previewCheck            Json?
  previewCheckAt          DateTime?
  /// The account that ran it. Not a relation: the account may go, and the line keeps its time.
  previewCheckByUserId    String?
  updatedAt               DateTime  @updatedAt

  @@map("instance_setting")
}

/// The install's email (F-115, ADR 0050): one row, `id = 'instance'`, made by the migration. Set
/// in the panel by an instance admin, or by settings, which lock it. Secrets are references.
model EmailSettings {
  id                    String        @id @default("instance")
  provider              EmailProvider @default(off)
  fromAddress           String?
  fromName              String?
  /// The Resend API key, in the secret store: a reference, never the value.
  resendApiKeySecretRef String?
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            SmtpSecurity?
  smtpUser              String?
  /// The SMTP password, in the secret store: a reference, never the value.
  smtpPasswordSecretRef String?
  /// The organization whose namespace in the secret store holds the two secrets above: the install
  /// has one email and the store keys values by organization, so it is the saving admin's.
  secretsOrganizationId String?
  /// Set when `OSTRA_EMAIL_PROVIDER` chose the provider: the panel shows it read-only.
  lockedBySettings      Boolean       @default(false)
  lastTestAt            DateTime?
  /// "Send a test mail"'s outcome, in words and IDs: never a mail's body or a secret.
  lastTestResult        String?
  updatedAt             DateTime      @updatedAt

  @@map("email_settings")
}

/// One organization's own settings (milestone 2): one row per organization, made when first written.
model OrganizationSetting {
  organizationId          String       @id
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Home's checklist: the Linear step was skipped for now (ticket 27), and by whom.
  linearSkippedAt         DateTime?
  linearSkippedByMemberId String?
  /// When every required step of Home's checklist was first done (F-076, 2026-11-21). From then on
  /// Home never shows the checklist again, even while no runner is online: it says so in a notice.
  setupCompletedAt        DateTime?
  // ---- milestone 8 (ADR 0068, ADR 0069) ----
  /// An organization admin allows public preview links (F-142). Off by default.
  publicPreviewLinks      Boolean      @default(false)
  /// An organization admin turned marketplace search on (F-146, Q316). Off by default.
  marketplaceSearch       Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("organization_setting")
}

/// A fixed value sealed with the secrets key, one row per key version (Q136, milestone 2's ticket
/// 45). At every start core and the panel open it, and refuse to start with a key that can't: the
/// key isn't the one the database's secrets were written with.
model SecretsKeyCheck {
  keyVersion Int      @id
  ciphertext Bytes
  nonce      Bytes
  createdAt  DateTime @default(now())

  @@map("secrets_key_check")
}

/// Who did what, when (F-073). Written in the transaction of the change it records.
model AuditEntry {
  id             String         @id @default(uuid(7))
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Set for an entry about something inside a project.
  projectId      String?
  project        Project?       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actorKind      AuditActorKind
  /// The member, runner or job that acted; `null` for the system.
  actorId        String?
  /// A dotted verb such as `task.started` or `provider.added`.
  action         String
  entity         String?
  entityId       String?
  /// IDs and settings only, never content or secrets.
  data           Json?
  createdAt      DateTime       @default(now())
  // ---- milestone 4 (F-073, ADR 0054) ----
  /// The actor's name as it was, so a removed member's entries still read.
  actorName      String?

  @@index([organizationId, createdAt])
  @@index([projectId])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@index([organizationId, entity, entityId])
  @@map("audit_entry")
}

/// A change to tell the panel's live views about (ADR 0035): written with the change, tailed by
/// every web process, never holding content.
model ChangeNotice {
  seq            BigInt       @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The kind of record: `task`, `runner`, `project`, …
  entity         String
  entityId       String
  createdAt      DateTime     @default(now())

  @@index([organizationId, seq])
  @@map("change_notice")
}

// ===========================================================================
// The organization
// ===========================================================================

/// The organization's own GitHub App or Linear app (Q102, F-005, F-006).
model Connection {
  id                     String         @id @default(uuid(7))
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind                   ConnectionKind
  /// The App's ID on GitHub, or the app's client ID on Linear.
  appId                  String
  slug                   String?
  /// The bot identity commits are authored by (F-078).
  botName                String?
  botEmail               String?
  /// Secret store references, never the values.
  privateKeySecretRef    String?
  webhookSecretSecretRef String?
  clientSecretSecretRef  String?
  /// The permissions the App was granted, as GitHub reports them.
  permissions            Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // ---- milestone 2: the Linear app (F-005). Every column is nullable or has a default. ----
  /// GitHub rows are `active`. A Linear row starts `pending`, before the manifest link, so its
  /// webhook URL can name it. Its `appId` is `pending` until the admin pastes the client ID, and
  /// `api-key` on the development seed (the domain's `linearAppIdPlaceholders`).
  state                 ConnectionState       @default(active)
  /// `failed`: words and IDs only, never a token or a vendor's body.
  failedReason          String?
  /// How events arrive: `polling` when the install has no public address (F-042).
  webhookMode           WebhookMode           @default(webhooks)
  /// How the Linear token was got. `api_key` is the development seed only; no panel action
  /// writes it. `null` on GitHub rows.
  credentialKind        ConnectionCredential?
  /// Linear's organization: its ID, its URL key and its name, as of the last read.
  externalWorkspaceId   String?
  externalWorkspaceKey  String?
  externalWorkspaceName String?
  /// The app's own user on the workspace, for the own-echo filter. `null` with an API key.
  appUserId             String?
  appUserName           String?
  /// Secret store references, never the values.
  accessTokenSecretRef  String?
  refreshTokenSecretRef String?
  accessTokenExpiresAt  DateTime?
  /// When the connection last became `active`.
  activatedAt           DateTime?
  /// The last webhook or poll that brought an event, for the panel's "last event" line.
  lastEventAt           DateTime?
  /// Set when polling's drift check found changes the webhooks never brought: "webhooks silent
  /// since …" in the panel (ticket 14). Cleared by the next webhook. The mode is never switched on its own.
  webhooksSilentSince   DateTime?
  /// The admin who started a pending connection. No foreign key: the row outlives the member.
  createdByMemberId     String?
  // ---- milestone 4, several GitHub accounts (F-136, ADR 0065) ----
  /// The App's owner, from `readApp`: its installation on this account is linked when seen. Filled
  /// on the next read for an existing row.
  ownerLogin            String?
  ownerAccountId        String?
  // ---- milestone 6, Linear's agent mode (F-012, ADR 0013, ADR 0057) ----
  /// The token's scopes as the tracker granted them, so core tells when agent mode's are missing.
  scopes                String[]              @default([])
  /// When an admin turned on agent mode (the re-authorization with the agent scopes).
  agentModeAt           DateTime?

  repos             Repo[]
  installations     CodeHostInstallation[]
  boards            Board[]
  webhookDeliveries WebhookDelivery[]
  tickets           Ticket[]
  oauthStates       OAuthState[]
  agentSessions     AgentSession[]

  @@unique([organizationId, kind, appId])
  @@unique([id, organizationId])
  /// One Linear connection per organization that isn't revoked (spec section 11, item 2).
  @@unique([organizationId], where: raw("kind = 'linear' AND state <> 'revoked'"), map: "connection_one_linear_per_organization")
  @@map("connection")
}

/// An API base URL and a token, in one of two formats (ADR 0033, F-088).
model ModelProvider {
  id                     String       @id @default(uuid(7))
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  baseUrl                String
  apiFormat              ApiFormat
  authScheme             AuthScheme
  /// The token, through the secret store (ADR 0025).
  tokenSecretRef         String
  /// The most sessions using it at once; `null` for no cap.
  sessionsAtOnce         Int?
  /// Usable on personal runners only when an admin allows it (Q47). Off by default.
  allowOnPersonalRunners Boolean      @default(false)
  modelsRefreshedAt      DateTime?
  /// New dispatches on this provider wait until then: it answered with a rate limit (F-088, ticket 26).
  dispatchHeldUntil      DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  models Model[]
  // ---- milestone 4 (F-135, ADR 0065) ----
  listEntries ProviderListEntry[]
  sessions    Session[]
  // ---- the profile's provider (ADR 0065 amended 2026-11-20) ----
  agentProfiles AgentProfile[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("model_provider")
}

/// A model the endpoint lists, matched to the models.dev catalog or entered as a custom model.
model Model {
  id                 String        @id @default(uuid(7))
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerId         String
  provider           ModelProvider @relation(fields: [providerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The model as the endpoint names it.
  endpointModelId    String
  /// The models.dev catalog entry it matched, or `null` for a custom model.
  catalogId          String?
  displayName        String?
  contextWindow      Int?
  maxOutputTokens    Int?
  /// Prices in US dollars per million tokens, from the catalog or an admin.
  inputPricePerMTok  Decimal?      @db.Decimal(12, 6)
  outputPricePerMTok Decimal?      @db.Decimal(12, 6)
  /// Milestone 2 (Q163, F-068): the cache-read and cache-write prices, in the same unit. `null`:
  /// not known, and the spend count prices that kind at the input price.
  cacheReadPricePerMTok  Decimal? @db.Decimal(12, 6)
  cacheWritePricePerMTok Decimal? @db.Decimal(12, 6)
  /// Milestone 4 (F-037, ADR 0055): where the prices came from, and when they last changed.
  priceSource            PriceSource?
  priceChangedAt         DateTime?
  /// Milestone 4 (F-137, ADR 0066): the model's reasoning controls, in models.dev's v2 shape as
  /// `@ostra/protocol`'s `reasoningControlsSchema` parses it. The catalog sync writes
  /// `catalogReasoning` and never `adminReasoning`, an admin's, which wins over it.
  catalogReasoning       Json?
  adminReasoning         Json?
  /// Whether the endpoint still lists it.
  listed             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  agentProfiles AgentProfile[]
  // ---- milestone 4 ----
  spendDailies  SpendDaily[]
  modelChoices  ModelChoice[]
  sessions      Session[]

  @@unique([providerId, endpointModelId])
  @@unique([id, organizationId])
  @@map("model")
}

/// A named set of runners that projects send tasks to (Q9, F-091). One default per organization.
model RunnerPool {
  id               String       @id @default(uuid(7))
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  isDefault        Boolean      @default(false)
  requiresApproval Boolean      @default(false)
  /// The pool's cap on boxes at once; `null` for none.
  maxBoxes         Int?
  // ---- milestone 5 (F-091) ----
  /// A new join token's lifetime in days: `null` for the setting's default
  /// (`OSTRA_JOIN_TOKEN_DAYS`), `0` for no expiry.
  joinTokenDays     Int?
  /// The admin who last changed the pool's settings; kept when the member leaves.
  updatedByMemberId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  joinTokens   JoinToken[]
  runners      Runner[]
  projectPools ProjectPool[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@unique([organizationId], where: raw("\"isDefault\""), map: "runner_pool_one_default_per_organization")
  @@map("runner_pool")
}

/// The key a runner joins a pool with: shown once, stored hashed (Q48, Q94).
model JoinToken {
  id                String       @id @default(uuid(7))
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poolId            String
  pool              RunnerPool   @relation(fields: [poolId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// SHA-256 of the token, hex. The token itself is never stored.
  tokenHash         String       @unique
  label             String?
  /// The token core writes at first start for the compose file's pool runner (F-013).
  bootstrap         Boolean      @default(false)
  createdByMemberId String?
  expiresAt         DateTime?
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  // ---- milestone 5 (F-091) ----
  /// The admin who revoked it; kept when the member leaves.
  revokedByMemberId String?
  /// How many runners joined with it.
  useCount          Int          @default(0)
  createdAt         DateTime     @default(now())

  runners Runner[]

  @@unique([id, organizationId])
  @@index([poolId])
  @@map("join_token")
}

/// `ostra runner` on a machine (ADR 0029). A pool runner belongs to a pool; a personal runner
/// belongs to one member and has no pool (checked in the migration).
model Runner {
  id              String       @id @default(uuid(7))
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            RunnerKind
  poolId          String?
  pool            RunnerPool?  @relation(fields: [poolId, organizationId], references: [id, organizationId], onDelete: Cascade)
  ownerMemberId   String?
  owner           Member?      @relation(fields: [ownerMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name            String
  /// The runner's Ed25519 public key, raw, base64url. The private half never leaves the runner.
  publicKey       String       @unique
  executor        ExecutorKind
  /// How the runner ends a task's processes together, as its last status said (ADR 0029,
  /// ticket 42). `null`: a runner that hasn't said, or an older one.
  processContainment ProcessContainment?
  capacity        Int
  labels          String[]
  version         String
  os              Json?
  state           RunnerState  @default(joining)
  /// The counter commands are numbered from, taken under this row's lock (ADR 0034).
  commandSeq      Int          @default(0)
  /// The highest contiguous command seq the runner acked.
  ackedCommandSeq Int          @default(0)
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  /// When an admin approved this pool runner, in a pool that requires approval (F-091, Q130).
  approvedAt      DateTime?
  /// The member who approved it; kept when the member leaves.
  approvedByMemberId String?
  // ---- milestone 5 (F-091, F-092, F-061, F-067, F-095, ADR 0059) ----
  /// The join token it joined with; `null` for a personal runner or one that joined before.
  joinTokenId     String?
  joinToken       JoinToken?     @relation(fields: [joinTokenId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// How it was installed, as its `hello` said (protocol minor 4).
  install         RunnerInstall?
  /// The protocol minor it last spoke.
  minor           Int?
  /// What it offers, as its last `status` said: slots, and CPU and memory where sizes apply.
  slots           Int?
  cpuMillis       Int?
  memoryMiB       Int?
  /// What its executor can do, as `@ostra/protocol`'s `runnerCapabilitiesSchema` parses it.
  capabilities    Json?
  /// When an admin drained it, and who; cleared by a resume.
  drainedAt          DateTime?
  drainedByMemberId  String?
  /// When it was last offered a task, so the one offered least recently wins a tie (ADR 0059).
  lastOfferedAt   DateTime?
  // ---- milestone 8 (F-141, ADR 0068) ----
  /// What it can show of a preview, as its last `hello` or `status` said (protocol minor 7,
  /// `previewSupportSchema`): the browser view and the tunnel. `null`: it never said, so no view opens.
  preview         Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  presence RunnerPresence?
  commands Command[]
  boxes    Box[]
  leases   Lease[]
  tasks    Task[]
  // ---- milestone 3 ----
  snapshots Snapshot[]

  @@unique([id, organizationId])
  @@index([organizationId, state])
  @@map("runner")
}

/// Which replica holds which runner's connection, with a connection epoch (ADR 0034).
model RunnerPresence {
  runnerId        String       @id
  runner          Runner       @relation(fields: [runnerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replicaId       String
  connectionEpoch Int
  carrier         String
  minor           Int
  connectedAt     DateTime     @default(now())
  lastSeenAt      DateTime     @default(now())
  disconnectedAt  DateTime?

  @@unique([runnerId, organizationId])
  @@index([replicaId])
  @@map("runner_presence")
}

/// Agent, model, instructions (Q28, Q70, F-021). Milestone 1 has the built-in OpenCode profile.
model AgentProfile {
  id             String       @id @default(uuid(7))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// The `AgentAdapter`'s registered name, such as `opencode`.
  adapter        String
  modelId        String?
  model          Model?       @relation(fields: [modelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  instructions   String?
  builtIn        Boolean      @default(false)
  // ---- milestone 3 (F-021, F-026, F-063, ADR 0049) ----
  /// What needs a person, as `@ostra/protocol`'s `approvalRulesSchema` parses it.
  approvalRules  Json          @default("[]")
  planFirst      Boolean       @default(false)
  access         ProfileAccess @default(everyone)
  /// Archived profiles are offered to no new task; tasks keep the profile they started with (Q189).
  archivedAt     DateTime?
  /// The MCP servers: name, transport, `readOnly`, the URL or the command, and secret references for
  /// an HTTP server's headers. Never a header's value.
  mcpServers     Json          @default("[]")
  // ---- milestone 4 (F-111, ADR 0044) ----
  /// After the task's last turn, one more asks the agent what the next task should know.
  closingTurn    Boolean       @default(false)
  // ---- milestone 4, keys per project (F-135, F-021, ADR 0065) ----
  /// The model by name: its models.dev catalog ID, or a custom model's endpoint ID. At most one is
  /// set (checked in the migration). `modelId` is still written, as the default list's row for the
  /// name, so a rollback works; nothing new reads it, and a later release drops it.
  modelCatalogId  String?
  modelCustomName String?
  // ---- milestone 4, the profile's provider (F-135, F-021, ADR 0065 amended 2026-11-20) ----
  /// The provider whose key and base URL its tasks use, and no other: a project whose list doesn't
  /// allow it can't run the profile. `null` (a profile saved before, whose model several providers or
  /// none served): the project's own choice serves the model by name, until an admin picks one.
  providerId      String?
  provider        ModelProvider? @relation(fields: [providerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// F-137 (ADR 0066): how much the model reasons. A new task copies it.
  effort         EffortLevel   @default(default)
  // ---- milestone 5 (F-069, ADR 0059) ----
  /// The labels a runner needs to run this profile's tasks, matched exactly as a subset.
  runnerLabels   String[]      @default([])
  // ---- milestone 6 (F-099, F-100, ADR 0028) ----
  /// Which built-in profile this is: the Refine and Review profiles are found by it and can be
  /// edited, never deleted. `null` for every other profile.
  builtInKind    BuiltInProfileKind?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members AgentProfileMember[]
  skills  AgentProfileSkill[]
  tasks   Task[]
  // ---- milestone 8 (F-145) ----
  libraryItems AgentProfileLibraryItem[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("agent_profile")
}

/// Who may use a `listed` profile (F-021). Organization admins use every profile.
model AgentProfileMember {
  id             String       @id @default(uuid(7))
  organizationId String
  profileId      String
  profile        AgentProfile @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([profileId, memberId])
  @@index([memberId])
  @@map("agent_profile_member")
}

/// A skill of a profile (F-021, ADR 0049): its `SKILL.md` text and up to 20 files, as blobs.
model AgentProfileSkill {
  id             String       @id @default(uuid(7))
  organizationId String
  profileId      String
  profile        AgentProfile @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name           String
  /// The `SKILL.md` text. Never logged.
  body           String
  /// The skill's other files: `[{ path, blobId }]`.
  files          Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([profileId, name])
  @@map("agent_profile_skill")
}

/// An encrypted value of the built-in secret store (ADR 0025, ticket 14). Other stores keep their
/// values elsewhere; every row elsewhere holds a reference, never a value.
model Secret {
  id             String       @id @default(uuid(7))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// What it's for, such as `model-provider.token`: IDs, never the value.
  purpose        String
  ciphertext     Bytes
  nonce          Bytes
  keyVersion     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("secret")
}

// ===========================================================================
// The project
// ===========================================================================

model Project {
  id                     String        @id @default(uuid(7))
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String
  access                 ProjectAccess @default(open)
  /// The default agent profile per task kind (Q28).
  defaultRefineProfileId String?
  defaultCodeProfileId   String?
  defaultReviewProfileId String?
  /// The default box size's name (Q43): `small`, `medium` or `large` (checked in the migration;
  /// milestone 5's `BoxSize` rows hold their limits).
  defaultBoxSize         String?
  /// Milestone 2 (F-064): the ticket prompt's template, or `null` for the built-in one.
  ticketTemplate         String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  members       ProjectMember[]
  pools         ProjectPool[]
  repos         Repo[]
  boards        Board[]
  environment   Environment?
  entries       EnvironmentEntry[]
  services      Service[]
  checks        Check[]
  snapshots     Snapshot[]
  automations   Automation[]
  tasks         Task[]
  taskRepos     TaskRepo[]
  coAuthors     TaskCoAuthor[]
  leases        Lease[]
  boxes         Box[]
  sessions      Session[]
  turns         Turn[]
  events        Event[]
  commands      Command[]
  approvals     Approval[]
  needsYouItems NeedsYouItem[]
  auditEntries  AuditEntry[]
  changeNotices ChangeNotice[]
  tickets       Ticket[]
  ticketWrites  TicketWrite[]
  blobs         Blob[]
  blobUploads   BlobUpload[]
  // ---- milestone 3 ----
  taskApprovalRules TaskApprovalRule[]
  diffComments      DiffComment[]
  diffCaches        DiffCache[]
  taskPullRequests  TaskPullRequest[]
  checkRuns         CheckRun[]
  notifications     Notification[]
  // ---- milestone 4 ----
  searchEntries     SearchEntry[]
  spendDailies      SpendDaily[]
  budgets           Budget[]
  heldTurns         HeldTurn[]
  taskMetrics       TaskMetric[]
  insightDailies    InsightDaily[]
  memoryNotes       MemoryNote[]
  memoryProposals   MemoryProposal[]
  memoryUses        MemoryUse[]
  reviewChecks      ReviewCheck[]
  /// Milestone 4 (F-135): `false` follows the organization's default provider list; `true` has its own.
  ownProviders        Boolean             @default(false)
  providerListEntries ProviderListEntry[]
  modelChoices        ModelChoice[]
  // ---- milestone 6 (F-100, F-040, ADR 0057, ADR 0058) ----
  /// Whether a code task's PRs get an AI review (F-100). On by default.
  aiReview                         Boolean @default(true)
  /// Whether a task from a tracker user ostra can't match waits for a member's approval (F-040).
  outsideApproval                  Boolean @default(true)
  /// The organization admin who last switched `outsideApproval`.
  outsideApprovalChangedByMemberId String?
  automationRuns     AutomationRun[]
  bulkStarts         BulkStart[]
  bulkStartItems     BulkStartItem[]
  agentSessions      AgentSession[]
  refineDrafts       RefineDraft[]
  refineDraftImages  RefineDraftImage[]
  ciRuns             CiRun[]
  taskRounds         TaskRound[]
  reviewRuns         ReviewRun[]
  findings           Finding[]
  taskReviewers      TaskReviewer[]
  environmentProposals EnvironmentProposal[]
  // ---- 2026-11-21 (F-021, ADR 0049 amended) ----
  /// Whether each repo's own skills (`.agents/skills`, `.claude/skills`, `.opencode/skills`) reach
  /// the agent beside the profile's. On by default; a project admin's switch, audited.
  repoSkills         Boolean @default(true)
  // ---- milestone 8 (ADR 0068) ----
  appProcesses         AppProcess[]
  taskAttachments      TaskAttachment[]
  taskPreviews         TaskPreview[]
  previewAccesses      PreviewAccess[]
  previewAccessMembers PreviewAccessMember[]
  previewLinks         PreviewLink[]
  previewViews         PreviewView[]
  previewCodes         PreviewCode[]

  // The target of every project record's composite foreign key (ADR 0026).
  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("project")
}

/// A member's role in a restricted project (Q35, F-087).
model ProjectMember {
  id             String      @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  memberId       String
  member         Member      @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role           ProjectRole
  createdAt      DateTime    @default(now())

  @@unique([projectId, memberId])
  @@index([memberId])
  @@map("project_member")
}

/// A pool a project may send tasks to, with the project's cap on it (Q9, Q43).
model ProjectPool {
  organizationId String
  projectId      String
  project        Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  poolId         String
  pool           RunnerPool @relation(fields: [poolId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The project's share of the pool, in boxes at once; `null` for none (ADR 0059).
  maxBoxes       Int?
  /// Milestone 5 (F-069, F-086): the pool's place in the project's ordered list, from 0.
  position       Int        @default(0)

  @@id([projectId, poolId])
  @@map("project_pool")
}

/// A code host repo linked to a project through the organization's App (Q29).
model Repo {
  id                   String     @id @default(uuid(7))
  organizationId       String
  projectId            String
  project              Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  connectionId         String
  connection           Connection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// The App installation that grants access to the repo. Milestone 4 (F-136): it must be a
  /// `CodeHostInstallation` row of this connection (the composite key below).
  installationId       String
  installation         CodeHostInstallation @relation(fields: [organizationId, connectionId, installationId], references: [organizationId, connectionId, installationId], onDelete: NoAction)
  /// The code host's own ID of the repo, which survives a rename.
  hostRepoId           String
  /// `owner/name`, as of the last check.
  fullName             String
  defaultBranch        String
  /// The repo's folder in a task's workspace (F-016).
  checkoutDir          String
  /// Where its variables and secrets are written in its checkout (spec section 11, item 7).
  envFile              String     @default(".env")
  /// Milestone 2: whether the code host says the repo is private, as of the last check.
  private              Boolean?
  /// The default branch's rules (F-055, F-060), parsed by the domain's `repoBranchRulesSchema`.
  branchRules          Json?
  /// When they were read: "Check again" reads them anew after 10 minutes (ticket 31).
  branchRulesCheckedAt DateTime?
  /// Milestone 4 (F-098): the repo's place in the project's order. Existing rows were numbered by creation.
  position             Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  entries   EnvironmentEntry[]
  taskRepos TaskRepo[]
  // ---- milestone 3 ----
  diffCaches DiffCache[]
  // ---- milestone 8 (F-140) ----
  appProcesses AppProcess[]

  @@unique([projectId, hostRepoId])
  @@unique([projectId, checkoutDir])
  @@unique([id, projectId])
  @@map("repo")
}

/// A tracker team or project, with its status mapping (Q67, F-007). Milestone 2.
model Board {
  id                  String     @id @default(uuid(7))
  organizationId      String
  projectId           String
  project             Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  connectionId        String
  connection          Connection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// The tracker's ID of the team or project.
  externalId          String
  name                String
  /// Parsed by the domain's `boardMappingSchema`.
  statusMap           Json
  /// Milestone 2: the team's key as of the last read, such as `OST`.
  key                 String?
  /// Polling (F-042, F-044): the tracker's `updatedAt` of the last ticket a committed page held.
  /// The next poll asks from it, minus the overlap.
  pollCursor          DateTime?
  lastPolledAt        DateTime?
  /// How many tickets the last poll changed in the cache (ticket 14), for the panel's "last poll" line.
  lastPollChanged     Int?
  /// Whether the tracker's own GitHub integration is installed (F-031); `null` until checked.
  integrationDetected Boolean?
  /// Set when a project admin detaches the board: it stops polling and starts no new task, but its
  /// tickets stay cached and its tasks keep their links. Attaching the team again clears it.
  detachedAt          DateTime?
  // ---- milestone 6 (F-012, ADR 0057) ----
  /// "Start from Linear": delegations and mentions in this board's team start tasks here. One
  /// board per team per organization.
  agentMode           Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tickets       Ticket[]
  ticketWrites  TicketWrite[]
  tasks         Task[]
  agentSessions AgentSession[]

  @@unique([projectId, externalId])
  @@unique([id, projectId])
  @@unique([organizationId, connectionId, externalId], where: raw("\"agentMode\""), map: "board_one_agent_mode_board_per_team")
  @@map("board")
}

/// A ticket's cached copy, per board (milestone 2, F-010). Upserted by the board and the
/// tracker's stable ID, never by the key, which changes when a ticket moves team. Its text is
/// untrusted: data in the prompt, never logged, never in a shell.
model Ticket {
  id               String                @id @default(uuid(7))
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project               @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  boardId          String
  board            Board                 @relation(fields: [boardId, projectId], references: [id, projectId], onDelete: Cascade)
  connectionId     String
  connection       Connection            @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// The tracker's stable ID of the ticket.
  externalId       String
  /// The key as of the last read, such as `OST-12`.
  key              String
  title            String
  /// Markdown. Never logged.
  description      String?
  /// The tracker's status, as of the last read.
  statusId         String?
  statusName       String?
  statusCategory   TicketStatusCategory?
  /// Linear's scale: 0 none, 1 urgent, 2 high, 3 medium, 4 low. Another tracker maps onto it.
  priority         Int?
  /// The label names, as a JSON array of strings.
  labels           Json                  @default("[]")
  /// Who the ticket is assigned to, as of the last read (the Inbox filters and shows it); `null`
  /// when it has no assignee, or the tracker adapter does not say.
  assigneeId       String?
  assigneeName     String?
  parentExternalId String?
  /// The tracker's own project the ticket is in (Linear's project), as of the last read (F-011:
  /// an intake rule's filter names it); `null` when it's in none, or the adapter does not say.
  trackerProjectId   String?
  trackerProjectName String?
  url              String
  /// Open on the tracker: not done, cancelled or archived.
  open             Boolean               @default(true)
  /// The tracker's `updatedAt` for the copy held here.
  trackerUpdatedAt DateTime
  /// Set when the ticket left the board or was deleted. The row stays for its tasks.
  removedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tasks        Task[]
  ticketWrites TicketWrite[]
  // ---- milestone 6 ----
  automationRuns AutomationRun[]
  bulkStartItems BulkStartItem[]
  agentSessions  AgentSession[]

  @@unique([boardId, externalId])
  @@unique([id, projectId])
  @@index([projectId, open, trackerUpdatedAt])
  @@map("ticket")
}

/// The tracker writer's outbox (milestone 2, F-031, F-046): one write to apply through the
/// tracker adapter, written in the transaction of the state change that caused it, and applied by
/// `ticket.sync` with its idempotency key.
model TicketWrite {
  id             String           @id @default(uuid(7))
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  boardId        String
  board          Board            @relation(fields: [boardId, projectId], references: [id, projectId], onDelete: Cascade)
  /// `null` for `create` until the ticket exists.
  ticketId       String?
  ticket         Ticket?          @relation(fields: [ticketId, projectId], references: [id, projectId], onDelete: NoAction)
  kind           TicketWriteKind
  /// What to write, parsed by the domain's `ticketWritePayloadSchema`. It can hold a comment's
  /// text: never logged.
  payload        Json
  /// Fixed by the task and the step (ADR 0037), so a replay finds this row instead of a second one.
  idempotencyKey String           @unique
  state          TicketWriteState @default(pending)
  attempts       Int              @default(0)
  /// What the tracker made: the comment's, the attachment's or the ticket's ID.
  externalId     String?
  /// Why the last attempt failed: words and IDs, never content.
  error          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  doneAt         DateTime?

  @@index([taskId])
  @@index([state, createdAt])
  @@map("ticket_write")
}

/// The project's one environment: the recipe for every box (ADR 0038, F-050).
model Environment {
  id              String            @id @default(uuid(7))
  organizationId  String
  projectId       String            @unique
  project         Project           @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  baseImage       String?
  setupScript     String?
  status          EnvironmentStatus @default(draft)
  savedAt         DateTime?
  savedByMemberId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // ---- milestone 8 (F-121, ADR 0068) ----
  /// "Screenshots after each turn": on by default, and it acts only once a primary app process is declared.
  screenshotsAfterTurn Boolean       @default(true)
  /// The routes they take, at most 5 paths.
  screenshotRoutes     Json          @default("[\"/\"]")
  /// The widths they take, `desktop` and `phone`, at most 2.
  screenshotWidths     Json          @default("[\"desktop\"]")

  entries   EnvironmentEntry[]
  services  Service[]
  checks    Check[]
  snapshots Snapshot[]
  // ---- milestone 6 (F-113) ----
  proposals EnvironmentProposal[]
  // ---- milestone 8 (F-140) ----
  appProcesses AppProcess[]

  @@unique([id, projectId])
  @@unique([projectId, organizationId])
  @@map("environment")
}

/// A variable, secret or file of one repo (Q33). The migration checks each kind's fields.
model EnvironmentEntry {
  id                   String               @id @default(uuid(7))
  organizationId       String
  projectId            String
  project              Project              @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  environmentId        String
  environment          Environment          @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Cascade)
  repoId               String
  repo                 Repo                 @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Cascade)
  kind                 EnvironmentEntryKind
  /// A variable's or secret's name.
  name                 String?
  /// A file's path in the repo's checkout.
  path                 String?
  /// A variable's value or a file's content. `null` for a secret.
  value                String?
  /// A secret's reference in the secret store.
  secretRef            String?
  availableDuringSetup Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([environmentId])
  @@map("environment_entry")
}

/// A program started beside the agent, such as a database (Q40, F-094). Milestone 3.
model Service {
  id             String      @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  environmentId  String
  environment    Environment @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Cascade)
  name           String
  image          String
  port           Int?
  variables      Json
  healthCheck    String?
  /// Milestone 8 (F-140): a service with a web UI is a preview under this label; `null`: not a preview.
  previewLabel   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([environmentId, name])
  @@map("service")
}

/// A command ostra runs before it opens a PR (F-054). Milestone 3.
model Check {
  id             String      @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  environmentId  String
  environment    Environment @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Cascade)
  name           String
  command        String
  repoId         String?
  /// Milestone 3 (ADR 0052): the check's timeout, and its place in the order the checks run.
  timeoutSeconds Int         @default(600)
  position       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([environmentId, name])
  @@map("check")
}

/// The environment prepared ahead of time (Q39, F-051). Milestone 3.
model Snapshot {
  id             String        @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  environmentId  String
  environment    Environment   @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Cascade)
  state          SnapshotState @default(queued)
  /// Why a rebuild was due: `environment-changed`, `lockfile-changed`, `nightly`.
  reason         String
  imageRef       String?
  digest         String?
  failedReason   String?
  // ---- milestone 3 (F-051, ADR 0038) ----
  /// The `docker` runner that built it and keeps it; there's no registry (Q184).
  runnerId        String?
  runner          Runner?             @relation(fields: [runnerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// The hash of the build's inputs: base image, repos' heads, setup script, setup secret names.
  buildInputsHash String?
  /// The scan of the image for each setup secret's value, before it's used.
  secretScan      SnapshotSecretScan?
  buildDurationMs Int?
  // ---- milestone 5 (F-120, ADR 0060) ----
  /// The organization's registry it was pushed to; `null` for one kept on its runner (milestone 3).
  registryId      String?
  registry        Registry?        @relation(fields: [registryId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// What built it: the host's Docker engine or a rootless BuildKit pod.
  builder         SnapshotBuilder?
  pushedAt        DateTime?
  createdAt      DateTime      @default(now())
  readyAt        DateTime?
  updatedAt      DateTime      @updatedAt

  @@index([projectId, state])
  @@map("snapshot")
}

/// A rule that starts tasks by itself: an intake rule, a schedule or a webhook (Q10, F-011, F-139). Milestone 2.
model Automation {
  id             String         @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind           AutomationKind
  name           String
  taskKind       TaskKind
  agentProfileId String?
  poolLabels     String[]
  /// An intake rule's ticket filter.
  filter         Json?
  /// A schedule's cron expression.
  schedule       String?
  enabled        Boolean        @default(true)
  // ---- milestone 6 (F-011, F-106, ADR 0056) ----
  /// The IANA time zone a schedule's cron is read in.
  timeZone          String                 @default("UTC")
  /// A prompt schedule's prompt, or a webhook's prompt template. Untrusted, private: never logged.
  prompt            String?
  /// A prompt schedule's task title, or a webhook's title template.
  title             String?
  /// Whether the tasks it starts wait for a member's approval.
  requireApproval   Boolean                @default(false)
  /// "Skip while the last one is open": an occurrence starts nothing while the last one's task is open.
  skipWhileOpen     Boolean                @default(true)
  /// Set with `pausedReason` (checked in the migration): a member paused it, or the hourly limit did.
  pausedAt          DateTime?
  pausedReason      AutomationPauseReason?
  /// A schedule's next due time, advanced by each scheduler tick.
  nextOccurrenceAt  DateTime?
  lastOccurrenceAt  DateTime?
  createdByMemberId String?
  updatedByMemberId String?
  /// Deleted: it starts nothing; its runs stay for the tasks' history.
  deletedAt         DateTime?
  // ---- webhooks (F-139, ADR 0056 amended 2026-11-21) ----
  /// A webhook's address: `POST /webhooks/automations/<webhookId>`. Random, made at the create; it routes, it isn't the credential.
  webhookId               String?                @unique
  /// A webhook's signing secret, in the secret store (set for a webhook only, checked in the migration).
  webhookSecretRef        String?
  /// How a webhook's request proves it holds the secret: its body's HMAC signature, or the secret as a bearer token.
  webhookAuth             AutomationWebhookAuth?
  /// A webhook's filter on the request body's fields: a list of conditions, all of which must hold.
  payloadFilter           Json?
  /// A webhook's body field that holds a request's idempotency key (`body.alert.id`), when no header gives one.
  idempotencyField        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  runs       AutomationRun[]
  bulkStarts BulkStart[]
  tasks      Task[]

  @@unique([id, projectId])
  /// The scheduler tick's due schedules (ADR 0037).
  @@index([enabled, nextOccurrenceAt], where: raw("schedule IS NOT NULL"), map: "automation_due_schedules")
  @@map("automation")
}

// ===========================================================================
// Milestone 6: automations' runs, bulk starts, agent sessions, drafts, the review loop and
// environment proposals (spec section 5.3)
// ===========================================================================

/// One run of an automation (F-011, F-106, F-139, ADR 0056): a schedule's occurrence, a rule's match
/// of a ticket, a dry run's "Start all", or a webhook's request. The partial unique indexes make each occurrence and each
/// ticket's match start at most once, however many replicas run.
model AutomationRun {
  id             String                @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project               @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  automationId   String
  automation     Automation            @relation(fields: [automationId, projectId], references: [id, projectId], onDelete: Cascade)
  kind           AutomationRunKind
  /// Set for an occurrence only (checked in the migration).
  occurrenceAt   DateTime?
  /// Set for a ticket match only (checked in the migration).
  ticketId       String?
  ticket         Ticket?               @relation(fields: [ticketId, projectId], references: [id, projectId], onDelete: NoAction)
  state          AutomationRunState
  /// Set when `state` is `skipped` (checked in the migration).
  skipReason     AutomationSkipReason?
  taskId         String?
  task           Task?                 @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: NoAction)
  bulkStartId    String?
  bulkStart      BulkStart?            @relation(fields: [bulkStartId, projectId], references: [id, projectId], onDelete: NoAction)
  /// A webhook request's idempotency key, as its SHA-256 in hex: never the key itself (F-139).
  idempotencyKeyHash String?
  createdAt      DateTime              @default(now())

  @@unique([automationId, occurrenceAt], where: raw("kind = 'occurrence'"), map: "automation_run_one_per_occurrence")
  @@unique([automationId, ticketId], where: raw("kind = 'ticket_match'"), map: "automation_run_one_match_per_ticket")
  @@index([automationId, createdAt])
  /// A webhook's repeat of a key within 24 hours (F-139).
  @@index([automationId, idempotencyKeyHash, createdAt], where: raw("\"idempotencyKeyHash\" IS NOT NULL"), map: "automation_run_idempotency_key")
  @@map("automation_run")
}

/// Many tickets started in one action (F-107, ADR 0056): from the Inbox, or a dry run's "Start all".
model BulkStart {
  id             String          @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  memberId       String
  source         BulkStartSource
  automationId   String?
  automation     Automation?     @relation(fields: [automationId, projectId], references: [id, projectId], onDelete: NoAction)
  /// The client's key: the same request twice starts nothing twice.
  requestKey     String
  taskKind       TaskKind
  agentProfileId String?
  /// How many tickets the member asked for.
  requested      Int
  createdAt      DateTime        @default(now())

  items          BulkStartItem[]
  automationRuns AutomationRun[]

  @@unique([memberId, requestKey])
  @@unique([id, projectId])
  @@map("bulk_start")
}

/// One ticket of a bulk start, started in its own transaction (F-107).
model BulkStartItem {
  id             String             @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  bulkStartId    String
  bulkStart      BulkStart          @relation(fields: [bulkStartId, projectId], references: [id, projectId], onDelete: Cascade)
  ticketId       String
  ticket         Ticket             @relation(fields: [ticketId, projectId], references: [id, projectId], onDelete: Cascade)
  state          BulkStartItemState @default(pending)
  /// Why it was skipped or failed, as a code (`has-task`, `budget`, ...): never content.
  reason         String?
  taskId         String?
  task           Task?              @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: NoAction)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([bulkStartId, ticketId])
  @@map("bulk_start_item")
}

/// A tracker's agent session (F-012, ADR 0013, ADR 0057): a delegation or a mention in Linear.
/// Written before a project is known, so its project is optional; its ticket, task and board are
/// the project's once matched.
model AgentSession {
  id                String            @id @default(uuid(7))
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        Connection        @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The tracker's session ID.
  externalSessionId String
  projectId         String?
  project           Project?          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  ticketId          String?
  ticket            Ticket?           @relation(fields: [ticketId, projectId], references: [id, projectId], onDelete: NoAction)
  taskId            String?
  task              Task?             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: NoAction)
  boardId           String?
  board             Board?            @relation(fields: [boardId, projectId], references: [id, projectId], onDelete: NoAction)
  state             AgentSessionState @default(active)
  /// The tracker user who delegated or mentioned, by the tracker's ID and the name it gave.
  creatorExternalId String
  creatorName       String
  /// The member the creator matched (ADR 0057), or `null` for a person from outside.
  matchedMemberId   String?
  lastPostAt        DateTime?
  /// When the next heartbeat is due: every post moves it 20 minutes on.
  heartbeatDueAt    DateTime?
  endedAt           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  activities AgentActivity[]

  @@unique([connectionId, externalSessionId])
  @@unique([id, organizationId])
  @@index([heartbeatDueAt], where: raw("state <> 'ended'"), map: "agent_session_heartbeat_due")
  @@map("agent_session")
}

/// The outbox of ostra's posts to an agent session (F-012). Its body is ostra's own words only.
model AgentActivity {
  id                 String             @id @default(uuid(7))
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentSessionId     String
  agentSession       AgentSession       @relation(fields: [agentSessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind               AgentActivityKind
  ephemeral          Boolean            @default(false)
  /// ostra's own words, from its templates: never agent output, a tool's input, a plan or a draft.
  body               String
  /// Posting it twice with this key posts it once.
  idempotencyKey     String
  state              AgentActivityState @default(pending)
  externalActivityId String?
  attempts           Int                @default(0)
  sentAt             DateTime?
  createdAt          DateTime           @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([state, createdAt])
  @@map("agent_activity")
}

/// A refine task's draft, one row per version (F-099, ADR 0028). Its text is never logged.
model RefineDraft {
  id               String             @id @default(uuid(7))
  organizationId   String
  projectId        String
  project          Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId           String
  task             Task               @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  version          Int
  /// Untrusted, private: never logged.
  description      String
  /// A JSON array of strings. Never logged.
  acceptanceCriteria Json             @default("[]")
  edgeCases        Json               @default("[]")
  openQuestions    Json               @default("[]")
  /// A JSON array of `{ title, description }`. Never logged.
  subTickets       Json               @default("[]")
  source           DraftSource
  editedByMemberId String?
  appliedAt        DateTime?
  appliedByMemberId String?
  /// The last "Update ticket" write that failed (ticket 41): when, and the part it stopped at, so
  /// the panel shows the version partly applied with "Retry sync". Cleared once the version is written.
  applyFailedAt    DateTime?
  applyFailedPart  DraftApplyPart?
  readyAt          DateTime?
  /// The ticket "Create ticket" made from a prompt task's draft.
  createdTicketKey String?
  createdAt        DateTime           @default(now())

  images RefineDraftImage[]

  @@unique([taskId, version])
  @@unique([id, projectId])
  @@map("refine_draft")
}

/// An image a member added to a refine draft, attached to the ticket on "Update ticket" (F-099).
model RefineDraftImage {
  id             String      @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  draftId        String
  draft          RefineDraft @relation(fields: [draftId, projectId], references: [id, projectId], onDelete: Cascade)
  blobId         String
  blob           Blob        @relation(fields: [blobId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name           String
  contentType    String
  size           Int
  attachedAt     DateTime?
  createdAt      DateTime    @default(now())

  @@map("refine_draft_image")
}

/// The CI result of one head of a task's PR (F-035, ADR 0058). ostra's own checks are left out.
model CiRun {
  id             String     @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskRepoId     String
  taskRepo       TaskRepo   @relation(fields: [taskRepoId, projectId], references: [id, projectId], onDelete: Cascade)
  headSha        String
  state          CiRunState @default(pending)
  /// A JSON array of `{ name, conclusion, externalId }`: never a log's text.
  checks         Json       @default("[]")
  firstSeenAt    DateTime   @default(now())
  completedAt    DateTime?
  /// The failing checks' log tails, as blobs: their text is never logged.
  logBlobIds     Json       @default("[]")
  updatedAt      DateTime   @updatedAt

  @@unique([taskRepoId, headSha])
  @@map("ci_run")
}

/// A fixing round of a task (F-035, F-101, F-105, ADR 0041): one per cause, however often it's asked.
model TaskRound {
  id             String     @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task       @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  kind           RoundKind
  /// Its number within its kind, from 1.
  number         Int
  automatic      Boolean
  /// What caused it: the head (CI), the review run (findings) or the review (changes requested).
  causeRef       String
  turnId         String?
  state          RoundState
  createdAt      DateTime   @default(now())

  @@unique([taskId, kind, causeRef])
  @@map("task_round")
}

/// One AI review of a code task's PRs (F-100, ADR 0058): one per round.
model ReviewRun {
  id             String         @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  codeTaskId     String
  codeTask       Task           @relation("ReviewRunCodeTask", fields: [codeTaskId, projectId], references: [id, projectId], onDelete: Cascade)
  reviewTaskId   String?
  reviewTask     Task?          @relation("ReviewRunReviewTask", fields: [reviewTaskId, projectId], references: [id, projectId], onDelete: NoAction)
  round          Int
  /// A JSON array of `{ repoId, prNumber, baseSha, headSha }`.
  heads          Json           @default("[]")
  state          ReviewRunState @default(running)
  /// The agent's summary. Untrusted: never logged.
  summary        String?
  blocking       Int            @default(0)
  nits           Int            @default(0)
  postedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  findings Finding[]

  @@unique([codeTaskId, round])
  @@unique([id, projectId])
  @@map("review_run")
}

/// A finding of an AI review (F-100). Its text is untrusted and never logged.
model Finding {
  id                String          @id @default(uuid(7))
  organizationId    String
  projectId         String
  project           Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reviewRunId       String
  reviewRun         ReviewRun       @relation(fields: [reviewRunId, projectId], references: [id, projectId], onDelete: Cascade)
  taskRepoId        String
  taskRepo          TaskRepo        @relation(fields: [taskRepoId, projectId], references: [id, projectId], onDelete: Cascade)
  path              String
  /// From 1 (checked in the migration).
  line              Int
  side              DiffSide
  severity          FindingSeverity
  title             String
  /// Untrusted, private: never logged.
  body              String
  suggestion        String?
  postedAs          FindingPostedAs?
  externalCommentId String?
  state             FindingState    @default(open)
  /// The review run that found it resolved or outdated.
  resolvedInRunId   String?
  createdAt         DateTime        @default(now())
  // ---- milestone 8 (F-121, ADR 0068) ----
  /// The review task's screenshots or recordings that show it, by the runner's attachment ID
  /// (`TaskAttachment.attachmentId`): a JSON array of strings, at most 5, each one checked against
  /// the review task's attachments when the review was handed in.
  attachmentIds     Json            @default("[]")

  @@index([reviewRunId])
  @@map("finding")
}

/// A reviewer of a task's PR (F-102): a GitHub user or team, matched to a member by the verified link.
model TaskReviewer {
  id              String         @id @default(uuid(7))
  organizationId  String
  projectId       String
  project         Project        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskRepoId      String
  taskRepo        TaskRepo       @relation(fields: [taskRepoId, projectId], references: [id, projectId], onDelete: Cascade)
  /// The GitHub user, or `null` for a team.
  githubUserId    String?
  login           String?
  /// The team, or `null` for a user.
  teamSlug        String?
  /// The member the user matched, or `null`.
  memberId        String?
  source          ReviewerSource
  /// The user's last review on the PR (`approved`, `changes_requested`, `commented`), as GitHub said.
  lastReviewState String?
  updatedAt       DateTime       @updatedAt

  @@unique([taskRepoId, githubUserId])
  @@unique([taskRepoId, teamSlug])
  @@map("task_reviewer")
}

/// An environment an onboarding task proposed (F-113, ADR 0038), for a project admin to decide.
model EnvironmentProposal {
  id                String                    @id @default(uuid(7))
  organizationId    String
  projectId         String
  project           Project                   @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  environmentId     String
  environment       Environment               @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Cascade)
  taskId            String
  task              Task                      @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  /// The proposal, parsed by the protocol's `environmentProposalSchema`. Its scripts are never logged.
  body              Json
  /// The agent's notes. Never logged.
  notes             String?
  state             EnvironmentProposalState  @default(proposed)
  decidedByMemberId String?
  decidedAt         DateTime?
  /// The environment's version an accepted proposal became.
  resultVersion     Int?
  createdAt         DateTime                  @default(now())
  /// Milestone 6's review (ticket 41): the environment as the decision found it, read by the
  /// domain's `environmentBaselineSchema` (its script, checks, services and variable names, never
  /// a value), so a decided proposal's diff stays readable for 7 days. `null` before this release.
  baseline          Json?
  /// Milestone 8 (F-140): where it came from: the onboarding task's `propose_environment`, or
  /// "Keep it" on a port an agent announced in a task, which proposes that one app process alone.
  source            EnvironmentProposalSource @default(onboarding)

  @@map("environment_proposal")
}

// ===========================================================================
// The task
// ===========================================================================

/// ostra's long-lived unit of work in one project (ADR 0006, ADR 0027, ADR 0028). Its state
/// columns map to the domain's union per kind (packages/domain, `lifecycles/mapping.ts`).
model Task {
  id                String          @id @default(uuid(7))
  organizationId    String
  projectId         String
  project           Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind              TaskKind
  source            TaskSource
  title             String
  /// The member's prompt (a prompt task). Never logged.
  prompt            String?
  /// The ticket's key (a ticket task, milestone 2).
  ticketKey         String?
  /// The same branch name in every repo of the task.
  branchName        String
  state             TaskState       @default(queued)
  /// Set only in `in_review` (checked in the migration).
  subState          TaskSubState?
  /// Set only in `needs_you` (checked in the migration).
  needsYouReason    NeedsYouReason?
  /// Set only in `stopped` (checked in the migration).
  stoppedReason     TaskStopReason?
  /// The member who drives the task, or `null` (one driver at a time, F-024).
  driverMemberId    String?
  creatorMemberId   String?
  /// The runner the member chose (a personal runner), or `null` to pick from the project's pools.
  runnerId          String?
  runner            Runner?         @relation(fields: [runnerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// The code task a review task reviews (Q71).
  reviewOfTaskId    String?
  /// The counter events are numbered from, taken under this row's lock (ADR 0035).
  eventSeq          Int             @default(0)
  /// Raised by every dispatch; writes from an older epoch are refused (ADR 0034, F-045).
  leaseEpoch        Int             @default(0)
  /// Why a queued task is still waiting for a runner, for the panel: words and IDs, never content (ticket 26).
  dispatchNote      String?
  // ---- milestone 2 ----
  /// A ticket task's ticket and board (F-010), or a prompt task's after "Create ticket" (F-097).
  ticketId          String?
  ticket            Ticket?         @relation(fields: [ticketId, projectId], references: [id, projectId], onDelete: NoAction)
  boardId           String?
  board             Board?          @relation(fields: [boardId, projectId], references: [id, projectId], onDelete: NoAction)
  /// ostra's one progress comment on the ticket, edited in place (F-031).
  progressCommentId String?
  /// Spent so far across the task's sessions, in micro-USD (F-068).
  spentMicroUsd     Int             @default(0)
  /// Why a queued task waits, as a code with its values (Q132, milestone 2's ticket 43). Parsed by
  /// `dispatchWaitSchema` in `@ostra/domain`; the panel words it. Replaces `dispatchNote`.
  dispatchWait      Json?
  // ---- milestone 3 ----
  /// The profile the task started with (F-021): kept when the profile is archived (Q189).
  agentProfileId    String?
  agentProfile      AgentProfile?   @relation(fields: [agentProfileId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// Plan first's progress (F-063): `none` until a plan is proposed.
  planState         PlanState       @default(none)
  // ---- milestone 4 ----
  /// F-137 (ADR 0066): the task's reasoning level, copied from the profile, changed by the driver.
  effort            EffortLevel     @default(default)
  // ---- milestone 5 (F-067, F-069, ADR 0059) ----
  /// Its place in a pool's queue: 1 urgent to 4 low, from the ticket's priority; a prompt task and
  /// a ticket without one are 3.
  queuePriority     Int             @default(3) @db.SmallInt
  /// When it was first queued; a requeue keeps it.
  queuedAt          DateTime?
  /// The labels a runner needs, copied from the profile when it's queued.
  requiredLabels    String[]        @default([])
  /// Who cancelled it from the queue (`stoppedReason` `cancelled`); kept when the member leaves.
  cancelledByMemberId String?
  // ---- milestone 6 (ADR 0056, ADR 0057, ADR 0058) ----
  /// What started it.
  origin             TaskOrigin      @default(member)
  automationId       String?
  automation         Automation?     @relation(fields: [automationId, projectId], references: [id, projectId], onDelete: NoAction)
  bulkStartId        String?
  /// The parent ticket of a sub-issue's task (F-077), by its ticket row.
  parentTicketId     String?
  /// The tracker user who started it from outside (F-040), by the tracker's ID and the name it gave.
  trackerActorId     String?
  trackerActorName   String?
  /// It may run on a pool only, never a personal runner (an outside task, ADR 0057).
  poolOnly           Boolean         @default(false)
  /// Set together (checked in the migration).
  approvedByMemberId String?
  approvedAt         DateTime?
  /// A rejected outside task's reason. Shown to the project's members, never logged.
  rejectedReason     String?
  /// The rounds and automatic turns since a person last acted (ADR 0041).
  ciRounds           Int             @default(0)
  reviewRounds       Int             @default(0)
  automaticTurns     Int             @default(0)
  lastPersonActionAt DateTime?
  /// An onboarding task (F-113): it proposes the environment and commits only `AGENTS.md`.
  onboarding         Boolean         @default(false)
  // ---- milestone 8 (F-144, ADR 0068) ----
  /// The task's preview ID: 128 random bits in lower-case base32, 26 characters, set at its first
  /// preview. It names the preview hosts, and survives a reopen on a fresh box. Not a secret.
  previewId          String?         @unique @db.VarChar(26)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  repos         TaskRepo[]
  coAuthors     TaskCoAuthor[]
  leases        Lease[]
  boxes         Box[]
  sessions      Session[]
  turns         Turn[]
  events        Event[]
  commands      Command[]
  sidecarCommands SidecarCommand[]
  approvals     Approval[]
  needsYouItems NeedsYouItem[]
  ticketWrites  TicketWrite[]
  blobs         Blob[]
  blobUploads   BlobUpload[]
  // ---- milestone 3 ----
  taskRules     TaskApprovalRule[]
  diffComments  DiffComment[]
  checkRuns     CheckRun[]
  notifications Notification[]
  // ---- milestone 4 ----
  searchEntries SearchEntry[]
  heldTurns     HeldTurn[]
  taskMetrics   TaskMetric[]
  memoryUses    MemoryUse[]
  // ---- milestone 6 ----
  automationRuns       AutomationRun[]
  bulkStartItems       BulkStartItem[]
  agentSessions        AgentSession[]
  refineDrafts         RefineDraft[]
  taskRounds           TaskRound[]
  reviewRunsAsCode     ReviewRun[]           @relation("ReviewRunCodeTask")
  reviewRunsAsReview   ReviewRun[]           @relation("ReviewRunReviewTask")
  environmentProposals EnvironmentProposal[]
  // ---- milestone 8 ----
  attachments          TaskAttachment[]
  previews             TaskPreview[]
  previewAccesses      PreviewAccess[]
  previewLinks         PreviewLink[]
  previewViews         PreviewView[]
  previewCodes         PreviewCode[]

  @@unique([id, projectId])
  /// One active code task per ticket per project (spec section 11, item 12).
  @@unique([projectId, ticketId], where: raw("kind = 'code' AND \"ticketId\" IS NOT NULL AND state NOT IN ('stopped', 'merged', 'done')"), map: "task_one_active_code_task_per_ticket")
  @@index([projectId, state])
  @@index([organizationId, state])
  /// Milestone 5: a pool's queue, in its order (ADR 0059).
  @@index([organizationId, state, queuePriority, queuedAt])
  /// Two tasks of a project never share a branch (F-016, Q136 item 10). A create writes the
  /// placeholder `pending` before the real name, so the index leaves it out (ticket 46).
  @@unique([projectId, branchName], where: raw("\"branchName\" <> 'pending'"), map: "task_project_branch_unique")
  @@map("task")
}

/// The task's branch and PR in one repo (Q29, F-030).
model TaskRepo {
  id               String        @id @default(uuid(7))
  organizationId   String
  projectId        String
  project          Project       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId           String
  task             Task          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  repoId           String
  repo             Repo          @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Cascade)
  branchName       String
  baseBranch       String
  state            TaskRepoState @default(no_branch)
  headSha          String?
  /// Whether the branch is ahead of its base after the session's final push.
  ahead            Boolean?
  prTitle          String?
  prBody           String?
  prNumber         Int?
  prUrl            String?
  /// Milestone 2 (ADR 0039): the commit `refs/ostra/wip/<taskId>` points at, and the branch head it
  /// was saved on.
  hiddenRefSha     String?
  hiddenRefBaseSha String?
  /// When the PR merged, or closed unmerged (F-079).
  mergedAt         DateTime?
  closedAt         DateTime?
  // ---- milestone 3 ----
  /// How many commits the base is ahead of the branch (F-070), and when that was read.
  behindBy         Int?
  behindCheckedAt  DateTime?
  /// 1 for the task repo's first branch; a reopen after a merge raises it (`-2`, `-3`, F-066).
  generation       Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  diffComments DiffComment[]
  pullRequests TaskPullRequest[]
  // ---- milestone 4 ----
  reviewChecks ReviewCheck[]
  // ---- milestone 6 ----
  ciRuns        CiRun[]
  findings      Finding[]
  taskReviewers TaskReviewer[]

  @@unique([taskId, repoId])
  @@unique([id, projectId])
  @@map("task_repo")
}

/// Who gets a `Co-authored-by` trailer on the task's commits (F-078).
model TaskCoAuthor {
  id             String   @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task     @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  memberId       String?
  name           String
  email          String
  createdAt      DateTime @default(now())

  @@unique([taskId, email])
  @@map("task_co_author")
}

/// The task's own computer, or on `host` its worktree, which follows the same states (ADR 0029).
model Box {
  id             String            @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project           @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task              @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  runnerId       String?
  runner         Runner?           @relation(fields: [runnerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  executor       ExecutorKind
  state          BoxState          @default(creating)
  failedReason   String?
  createdAt      DateTime          @default(now())
  readyAt        DateTime?
  /// Milestone 2 (F-096): since when the box has had no turn.
  idleSince      DateTime?
  stoppedAt      DateTime?
  releasedAt     DateTime?
  releaseReason  BoxReleaseReason?
  updatedAt      DateTime          @updatedAt
  /// The sidecar's connection, for a `docker` or `kubernetes` box (ADR 0034, Q129): which replica
  /// holds it, and a connection epoch, so a second connection of the box evicts the first (4409).
  sidecarReplicaId       String?
  sidecarConnectionEpoch Int       @default(0)
  sidecarConnectedAt     DateTime?
  sidecarLastSeenAt      DateTime?
  sidecarDisconnectedAt  DateTime?
  /// The counter the sidecar's commands are numbered from, taken under this row's lock.
  sidecarCommandSeq      Int       @default(0)
  // ---- milestone 5 (F-095, F-120, F-093) ----
  /// The size's name and its limits when the box was made; `null` where sizes don't apply.
  size           String?
  cpuMillis      Int?
  memoryMiB      Int?
  /// The snapshot image it starts from, by digest; `null` for none.
  imageRef       String?
  imageDigest    String?
  /// Why it's still `creating`: no node yet, or its image is being pulled. `null` otherwise.
  waitingReason  BoxWaitingReason?
  waitingSince   DateTime?
  /// When its pod was scheduled after a wait.
  scheduledAt    DateTime?
  // ---- milestone 8 (F-141, Q299) ----
  /// The last heartbeat of a pane or a viewer page watching one of its previews: the idle sweep
  /// keeps a box warm while it's under 2 minutes old, up to `OSTRA_PREVIEW_WARM_MINUTES`.
  previewWatchedAt DateTime?

  leases          Lease[]
  sessions        Session[]
  sidecarCommands SidecarCommand[]

  @@unique([id, taskId])
  @@index([taskId])
  /// Milestone 5: the counts of a runner's and a project's boxes (ADR 0059).
  @@index([runnerId, state])
  @@index([projectId, state])
  @@map("box")
}

/// The server's grant that lets one box work on the task, with its epoch (ADR 0034, F-045). At
/// most one lease per task is active.
/// A command for a box's sidecar (ADR 0034, Q129): a `docker` or `kubernetes` box's task's `steer`,
/// `interrupt`, `stop` and approval answers go to its sidecar, numbered per box, not to the runner.
model SidecarCommand {
  id             String         @id @default(uuid(7))
  organizationId String
  projectId      String
  taskId         String
  task           Task           @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  boxId          String
  box            Box            @relation(fields: [boxId, taskId], references: [id, taskId], onDelete: Cascade)
  seq            Int
  kind           CommandKind
  /// The command's body, as `@ostra/protocol`'s `commandBodySchemas[kind]` parses it.
  body           Json
  notAfter       DateTime
  createdAt      DateTime       @default(now())
  ackedAt        DateTime?
  result         CommandResult?
  reason         String?

  @@unique([boxId, seq])
  @@index([taskId])
  @@map("sidecar_command")
}

model Lease {
  id             String     @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task       @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  epoch          Int
  runnerId       String
  runner         Runner     @relation(fields: [runnerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  boxId          String
  box            Box        @relation(fields: [boxId, taskId], references: [id, taskId], onDelete: Cascade)
  state          LeaseState @default(active)
  grantedAt      DateTime   @default(now())
  acceptedAt     DateTime?
  endedAt        DateTime?
  /// Why it ended: `released`, `grace-expired`, `superseded`, `rejected`, `offer-timeout`.
  endReason      String?
  // ---- milestone 8 (F-141, Q300) ----
  /// Why its box runs: a turn of the agent, or the app alone ("Start the app"), which launches no agent.
  purpose              LeasePurpose @default(turn)
  /// The member who pressed "Start the app", for an `app` lease.
  appStartedByMemberId String?

  @@unique([taskId, epoch])
  @@unique([taskId], where: raw("state = 'active'"), map: "lease_one_active_per_task")
  @@map("lease")
}

/// One conversation with one agent profile in one box (ADR 0006). At most one active per task.
model Session {
  id                 String          @id @default(uuid(7))
  organizationId     String
  projectId          String
  project            Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId             String
  task               Task            @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  agentProfileId     String?
  boxId              String?
  box                Box?            @relation(fields: [boxId, taskId], references: [id, taskId], onDelete: NoAction)
  origin             SessionOrigin
  state              SessionState    @default(starting)
  /// Set when the session ended (checked in the migration).
  outcome            SessionOutcome?
  /// The agent's own session ID, for resuming it.
  agentSessionId     String?
  /// The highest contiguous session number saved: the ingest cursor (ADR 0034).
  ingestedSeq        Int             @default(0)
  /// The key proxy's counts for the session (F-089), summed from `usage.recorded`.
  inputTokens        Int             @default(0)
  outputTokens       Int             @default(0)
  cacheReadTokens    Int             @default(0)
  cacheWriteTokens   Int             @default(0)
  /// Milestone 4 (F-137): the reasoning tokens, a part of `outputTokens`.
  reasoningTokens    Int             @default(0)
  /// Milestone 2 (ADR 0039): the last session archive uploaded, and the turn it followed. No
  /// foreign key: retention may delete the blob, and the next reopen then uses the template.
  archiveBlobId      String?
  archiveTurnOrdinal Int?
  /// Spent in this session, in micro-USD (F-068).
  spentMicroUsd      Int             @default(0)
  /// The runaway limit that stopped it, if one did.
  limitReached       SessionLimit?
  /// Milestone 4 (F-135, ADR 0065): the provider and model row its start resolved; the task spec and
  /// the credentials name only these. Back-filled from the session's profile's model.
  providerId         String?
  provider           ModelProvider?  @relation(fields: [providerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  modelId            String?
  model              Model?          @relation(fields: [modelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  startedAt          DateTime        @default(now())
  endedAt            DateTime?
  updatedAt          DateTime        @updatedAt

  turns     Turn[]
  events    Event[]
  approvals Approval[]
  // ---- milestone 3 ----
  checkRuns CheckRun[]
  // ---- milestone 4 ----
  memoryUses MemoryUse[]

  @@unique([id, taskId])
  @@unique([taskId], where: raw("state IN ('starting', 'running', 'waiting', 'idle')"), map: "session_one_active_per_task")
  @@index([taskId])
  @@map("session")
}

/// One prompt and the agent's full response (Q42).
model Turn {
  id             String    @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project   @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task      @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId, taskId], references: [id, taskId], onDelete: Cascade)
  /// 1 for the session's first turn.
  ordinal        Int
  /// The task seq of its `turn.started` event, for paging history by turn (ADR 0036).
  startSeq       Int
  stopReason     String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  // ---- milestone 3 (F-084): filled as the turn's usage arrives ----
  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  cacheReadTokens  Int     @default(0)
  cacheWriteTokens Int     @default(0)
  spentMicroUsd    Int     @default(0)
  /// True when any of the turn's usage was estimated by the key proxy.
  estimated        Boolean @default(false)
  /// The agent's own time in the turn, in ms.
  agentMs          Int?
  // ---- milestone 4 (F-137, ADR 0066) ----
  /// The level the turn ran at, and the level asked for when the clamp changed it. `null` for a
  /// turn before this release.
  effort             EffortLevel?
  effortAdjustedFrom EffortLevel?
  /// The reasoning tokens the endpoint reported: a part of `outputTokens`.
  reasoningTokens    Int          @default(0)

  @@unique([sessionId, ordinal])
  @@index([taskId, startSeq])
  @@map("turn")
}

/// One thing the agent or ostra did, saved before ostra acts on it, with two numbers (ADR 0035):
/// `seq` per task (the browser's cursor) and `sessionSeq` per session (the peer's, `null` for the
/// server's own events). `payload` is the event as `@ostra/protocol`'s `taskEventSchema` parses it.
model Event {
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task     @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  seq            Int
  sessionId      String
  session        Session  @relation(fields: [sessionId, taskId], references: [id, taskId], onDelete: Cascade)
  sessionSeq     Int?
  leaseEpoch     Int?
  kind           String
  payload        Json
  /// When the peer recorded it (the server, for its own).
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  @@id([taskId, seq])
  @@unique([sessionId, sessionSeq])
  @@index([taskId, seq], where: raw("kind IN ('turn.started', 'turn.ended', 'turn.failed')"), map: "event_turn_boundary")
  @@map("event")
}

/// A numbered instruction to a runner or a sidecar: the outbox (ADR 0034). `seq` comes from
/// `Runner.commandSeq`, taken under the runner row's lock, so numbers are gap-free.
model Command {
  id             String         @id @default(uuid(7))
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runnerId       String
  runner         Runner         @relation(fields: [runnerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  seq            Int
  kind           CommandKind
  /// The command's body, as `@ostra/protocol`'s `commandBodySchemas[kind]` parses it.
  body           Json
  projectId      String?
  project        Project?       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Set only with projectId: the migration checks it (F-086).
  taskId         String?
  task           Task?          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  /// Server time past which the peer rejects it.
  notAfter       DateTime
  createdAt      DateTime       @default(now())
  ackedAt        DateTime?
  result         CommandResult?
  reason         String?

  @@unique([runnerId, seq])
  @@index([runnerId, seq], where: raw("\"ackedAt\" IS NULL"), map: "command_unacked")
  @@map("command")
}

/// The agent's request to do something its rules hold back (F-026).
model Approval {
  id                 String               @id @default(uuid(7))
  organizationId     String
  projectId          String
  project            Project              @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId             String
  task               Task                 @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  sessionId          String
  session            Session              @relation(fields: [sessionId, taskId], references: [id, taskId], onDelete: Cascade)
  toolCallId         String
  /// The options the agent offered, as the `approval.requested` event holds them.
  options            Json
  state              ApprovalState        @default(open)
  decision           ApprovalDecision?
  optionId           String?
  answeredByMemberId String?
  ruleId             String?
  closedReason       ApprovalCloseReason?
  // ---- milestone 3 (F-026, ADR 0049) ----
  /// Whether `ruleId` names a profile's rule or a task rule.
  ruleSource         ApprovalRuleSource?
  /// What the request touched, for the card and the "for this task" pattern. Never logged.
  subjectKind        ApprovalSubjectKind?
  subjectValue       String?
  /// A deny's reason, shown to the project's members; never logged, never in the audit entry.
  denyReason         String?
  createdAt          DateTime             @default(now())
  resolvedAt         DateTime?

  needsYouItems NeedsYouItem[]
  taskRules     TaskApprovalRule[]

  @@unique([id, taskId])
  @@index([taskId, state])
  @@map("approval")
}

/// Something a person has to act on, with its audience (Q73, F-036).
model NeedsYouItem {
  id                 String           @id @default(uuid(7))
  organizationId     String
  projectId          String
  project            Project          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId             String
  task               Task             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  reason             NeedsYouReason
  audience           NeedsYouAudience
  state              NeedsYouState    @default(open)
  approvalId         String?
  approval           Approval?        @relation(fields: [approvalId, taskId], references: [id, taskId], onDelete: Cascade)
  /// The agent's summary, for a session that ended without changes (F-065).
  summary            String?
  // ---- milestone 3 ----
  /// A question's ID (F-024), and a plan's turn (F-063), for the item's answer.
  questionId         String?
  planTurnId         String?
  /// When fan-out first ran for it (F-036).
  notifiedAt         DateTime?
  createdAt          DateTime         @default(now())
  resolvedAt         DateTime?
  resolvedByMemberId String?

  notifications Notification[]

  @@unique([id, projectId])
  @@index([projectId, state])
  @@index([taskId])
  @@map("needs_you_item")
}

/// A webhook a code host or tracker sent, recorded once by its delivery ID (ADR 0011).
model WebhookDelivery {
  id             String                @id @default(uuid(7))
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     Connection            @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The vendor's delivery ID (`X-GitHub-Delivery`).
  deliveryId     String
  event          String
  status         WebhookDeliveryStatus @default(received)
  receivedAt     DateTime              @default(now())
  processedAt    DateTime?
  // ---- milestone 2 (F-043, F-046) ----
  /// The verified body, for `webhook.process` to act on from the queue. Never logged.
  payload        Json?
  /// SHA-256 of the signature header: Linear's claim key beside the delivery ID.
  signatureHash  String?
  /// From the sender's timestamp to the insert, in ms; over 10 s logs a warning.
  transitMs      Int?
  /// Why processing failed: words and IDs, never content.
  error          String?
  /// The ticket's key, once `webhook.process` has read it, for the "last event" line.
  ticketKey      String?

  @@unique([connectionId, deliveryId])
  /// Postgres treats nulls as distinct, so this holds only where the hash is set.
  @@unique([connectionId, signatureHash])
  @@map("webhook_delivery")
}

/// A recorded idempotent call (ADR 0011, F-046): the plumbing's `IdempotencyStore`, keyed per
/// organization. Its result is JSON of IDs and results, never content.
model IdempotencyRecord {
  id             String           @id @default(uuid(7))
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// ADR 0037's form: parts joined by `:`.
  key            String
  state          IdempotencyState
  result         Json?
  claimedAt      DateTime
  doneAt         DateTime?

  @@unique([organizationId, key])
  @@map("idempotency_record")
}

/// What a vendor last said about one credential's rate limit (Q20): the plumbing's
/// `RateBudgetStore`. The key names a credential, never holds it.
model RateBudget {
  id             String       @id @default(uuid(7))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  remaining      Int
  limit          Int?
  resetAt        DateTime
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("rate_budget")
}

/// A stored blob (ADR 0043, F-114), in any store. A `postgres` blob's bytes are its chunks, in
/// their own table, never beside the event log. The owning task, when there is one, is set.
model Blob {
  id             String        @id @default(uuid(7))
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Set only with projectId: the migration checks it (F-086).
  taskId         String?
  task           Task?         @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  store          BlobStoreKind
  /// The store's key for it (`StoredBlob.key`): safe to store and log.
  key            String
  /// What it's for, such as `session-archive` or `ticket-file`: words, never content.
  purpose        String
  contentType    String
  size           Int
  /// SHA-256 of the bytes, lower-case hex.
  sha256         String
  createdAt      DateTime      @default(now())

  chunks BlobChunk[]
  // ---- milestone 6 ----
  draftImages RefineDraftImage[]
  // ---- milestone 8 (F-121) ----
  taskAttachments TaskAttachment[]

  @@unique([store, key])
  @@unique([id, organizationId])
  @@index([taskId])
  @@index([organizationId, createdAt])
  @@map("blob")
}

/// A chunked upload in flight (ADR 0043). A drop leaves it here, and the next start for the same
/// task, purpose and digest resumes it.
model BlobUpload {
  id             String        @id @default(uuid(7))
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Set only with projectId: the migration checks it (F-086).
  taskId         String?
  task           Task?         @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  store          BlobStoreKind
  purpose        String
  contentType    String
  expectedSha256 String
  size           Int
  receivedBytes  Int           @default(0)
  /// An S3-compatible store's own upload ID and the parts it has (ticket 11).
  storeUploadId  String?
  storeParts     Json?
  /// Set once finished: its blob, so finishing twice answers the same.
  blobId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  chunks BlobChunk[]

  @@unique([id, organizationId])
  @@index([organizationId, purpose, expectedSha256])
  @@map("blob_upload")
}

/// One chunk of a `postgres` blob's bytes, at most 1 MiB (ADR 0043). It belongs to its upload
/// while that's in flight, and to its blob after: finishing moves it (sets `blobId`, clears
/// `uploadId`; the migration checks exactly one is set), so dropping the upload keeps the bytes.
model BlobChunk {
  id             String       @id @default(uuid(7))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadId       String?
  upload         BlobUpload?  @relation(fields: [uploadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  blobId         String?
  blob           Blob?        @relation(fields: [blobId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// From 0, in order.
  ordinal        Int
  /// Where the chunk starts in the blob.
  offset         Int
  bytes          Bytes

  @@unique([uploadId, ordinal])
  @@unique([blobId, ordinal])
  @@map("blob_chunk")
}

/// Linear's OAuth `state` and PKCE verifier (F-005), bound to the admin's session, for 10 minutes.
model OAuthState {
  id                    String       @id @default(uuid(7))
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId          String
  connection            Connection   @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// SHA-256 of the `state` value, so a read of this table can't replay a callback.
  stateHash             String       @unique
  /// The PKCE verifier, in the secret store.
  codeVerifierSecretRef String
  memberId              String
  /// The panel session (better-auth's) that started it; the callback must come back on it.
  authSessionId         String
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime     @default(now())

  @@index([connectionId])
  @@map("oauth_state")
}

// ===========================================================================
// Enums. Values that cross into `@ostra/protocol` with a hyphen there are written with an
// underscore here; `src/enums.ts` maps them both ways.

// ===========================================================================
// Milestone 3: step in and come back
// ===========================================================================

/// A "for this task" rule (F-026, ADR 0049, Q167): the request's tool and a pattern drawn from it.
/// Its ID is the protocol's `TaskRule.ruleId`, written before the `approval-answer` command.
model TaskApprovalRule {
  id                String       @id @default(uuid(7))
  organizationId    String
  projectId         String
  project           Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId            String
  task              Task         @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  tool              ApprovalTool
  /// An exact path, a command prefix, a host or an MCP tool's name. May quote the repo: never logged.
  pattern           String
  /// The approval whose "Approve for this task" wrote it.
  approvalId        String?
  approval          Approval?    @relation(fields: [approvalId, taskId], references: [id, taskId], onDelete: NoAction)
  createdByMemberId String
  createdAt         DateTime     @default(now())

  @@unique([taskId, tool, pattern])
  @@map("task_approval_rule")
}

/// A member's comment on a line of a task repo's diff (F-072, ADR 0051). A draft until sent.
model DiffComment {
  id             String           @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  taskRepoId     String
  taskRepo       TaskRepo         @relation(fields: [taskRepoId, projectId], references: [id, projectId], onDelete: Cascade)
  memberId       String
  path           String
  side           DiffSide
  line           Int
  /// The head the comment was written on: a later head that changes the line makes it outdated.
  headSha        String
  /// The member's text. Never logged.
  body           String
  state          DiffCommentState @default(draft)
  /// The task seq of the member message that carried it.
  sentInSeq      Int?
  outdatedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([taskId, state])
  @@index([taskId, memberId, state])
  @@map("diff_comment")
}

/// The code host's compare of a base and a head, cached (F-027, ADR 0051).
model DiffCache {
  id             String   @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  repoId         String
  repo           Repo     @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Cascade)
  baseSha        String
  headSha        String
  /// The compare as the code host adapter returns it. Holds the repo's code: never logged.
  result         Json
  fetchedAt      DateTime @default(now())

  @@unique([repoId, baseSha, headSha])
  @@map("diff_cache")
}

/// Every PR a task repo has had (F-066, ADR 0052): a reopen after a merge opens a new one.
model TaskPullRequest {
  id             String           @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskRepoId     String
  taskRepo       TaskRepo         @relation(fields: [taskRepoId, projectId], references: [id, projectId], onDelete: Cascade)
  number         Int
  url            String
  branchName     String
  state          PullRequestState @default(open)
  draft          Boolean          @default(false)
  /// Set when ostra made it a draft for a failed check, so ostra may mark it ready (ADR 0052).
  draftByOstra   Boolean          @default(false)
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([taskRepoId, number])
  @@map("task_pull_request")
}

/// One check's run after one turn (F-054, ADR 0052).
model CheckRun {
  id             String         @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task           @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  sessionId      String
  session        Session        @relation(fields: [sessionId, taskId], references: [id, taskId], onDelete: Cascade)
  turnOrdinal    Int
  /// The environment's check; kept by ID and name, so a deleted check's runs still read.
  checkId        String
  name           String
  /// The repo it ran in, or `null` for the workspace root (Q188).
  repoId         String?
  status         CheckRunStatus @default(running)
  exitCode       Int?
  durationMs     Int?
  /// The full output, as a blob. Never logged.
  outputBlobId   String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  @@unique([sessionId, turnOrdinal, checkId])
  @@index([taskId])
  @@map("check_run")
}

/// A member's notification of one needs-you moment, or a test (F-036, ADR 0050).
model Notification {
  id             String            @id @default(uuid(7))
  organizationId String
  memberId       String
  member         Member            @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The project, task and item, all `null` for a test notification. Set with a task or an item
  /// only: the migration checks it (F-086).
  projectId      String?
  project        Project?          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String?
  task           Task?             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  needsYouItemId String?
  needsYouItem   NeedsYouItem?     @relation(fields: [needsYouItemId, projectId], references: [id, projectId], onDelete: Cascade)
  kind           NotificationKind
  /// When the member read it in the panel: a mail still waiting is then skipped.
  readAt         DateTime?
  state          NotificationState @default(open)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  deliveries NotificationDelivery[]

  @@unique([id, organizationId])
  /// One notification per member and item.
  @@unique([memberId, needsYouItemId], where: raw("\"needsYouItemId\" IS NOT NULL"), map: "notification_one_per_member_and_item")
  @@index([memberId, state])
  @@index([memberId, readAt])
  @@map("notification")
}

/// One channel's delivery of a notification (F-036, F-115, ADR 0050).
model NotificationDelivery {
  id                String              @id @default(uuid(7))
  organizationId    String
  notificationId    String
  notification      Notification        @relation(fields: [notificationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  channel           NotificationChannel
  /// The adapter's registered name, such as `resend` or `linear`.
  adapter           String
  state             DeliveryState       @default(pending)
  /// The item, the member and the channel (and the moment): the adapter sends each key once.
  idempotencyKey    String              @unique
  /// The provider's ID of what it sent, for an edit (the tracker's coalescing).
  providerMessageId String?
  attempts          Int                 @default(0)
  /// Why the last attempt failed, in words and IDs: never a mail's body or a token.
  error             String?
  /// When it's due: email waits `OSTRA_EMAIL_DELAY_SECONDS`.
  dueAt             DateTime            @default(now())
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([state, dueAt])
  @@index([notificationId])
  @@map("notification_delivery")
}

/// A member's choice for one moment and channel (F-036, F-115). No row means the default (ADR 0050).
model NotificationPreference {
  id             String              @id @default(uuid(7))
  organizationId String
  memberId       String
  member         Member              @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind           NotificationKind
  channel        NotificationChannel
  enabled        Boolean
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([memberId, kind, channel])
  @@map("notification_preference")
}

/// One account mail's sending (F-002, F-115, ADR 0053; ticket 19): an invitation, a membership's
/// verification or a reset, by the record's ID. `account-mail.send` sends each once; a replay finds
/// it `sent` and sends nothing. Its `error` is what the invitation's row shows the admin ("Mail
/// failed: ..."). Never the mail, its address or its link: those exist only while it's sent.
model AccountMailDelivery {
  id                String             @id @default(uuid(7))
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purpose           AccountMailPurpose
  /// The invitation's, the membership's or the reset link's ID. No foreign key: the three tables differ.
  recordId          String
  /// The adapter's registered name, `resend` or `smtp`, once one was used.
  adapter           String?
  state             DeliveryState      @default(pending)
  attempts          Int                @default(0)
  /// The provider's words for the last failure, or why it was skipped. Never a mail's body, an address or a link.
  error             String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([purpose, recordId])
  @@index([organizationId, recordId])
  @@map("account_mail_delivery")
}

/// A member's `ostra login` (F-103, ADR 0051): its own credential, made by a device-code grant.
model CliSession {
  id             String    @id @default(uuid(7))
  organizationId String
  memberId       String
  member         Member    @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The SHA-256 of the token, which the CLI was shown once. The token itself is never stored.
  tokenHash      String    @unique
  /// The machine's name the CLI sent, for "Account".
  name           String
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  /// The tunnels' tickets `ostra preview` got with this session (milestone 8, F-143).
  previewCodes   PreviewCode[]

  @@index([memberId])
  @@index([userId])
  @@map("cli_session")
}

