// ===========================================================================
// Milestone 4, keys per project (ticket 45, spec section 5.5, ADR 0065). Additive only.
// ===========================================================================

/// A provider on a list (F-135): the organization's default list (`projectId` null), which every
/// project follows until it has its own, or a project's own list.
model ProviderListEntry {
  id              String        @id @default(uuid(7))
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// `null` for the organization's default list.
  projectId       String?
  project         Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  providerId      String
  provider        ModelProvider @relation(fields: [providerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// No foreign key: the admin who added it, kept by ID; `null` for the upgrade's and the first provider's.
  addedByMemberId String?
  createdAt       DateTime      @default(now())

  @@unique([organizationId, projectId, providerId])
  /// The default list's rows: Postgres treats nulls as distinct in the unique above.
  @@unique([organizationId, providerId], where: raw("\"projectId\" IS NULL"), map: "provider_list_entry_one_per_default_list")
  @@index([providerId])
  @@map("provider_list_entry")
}

/// Which provider serves a model name on a list (F-135): the default list's (`projectId` null) or a
/// project's own. Only an organization admin's save, the keep rule or the upgrade writes one.
model ModelChoice {
  id               String            @id @default(uuid(7))
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The model by name: `catalog:<catalogId>` or `custom:<endpointModelId>` (the domain's `modelNameKey`), the key the unique index uses.
  modelKey         String
  modelCatalogId   String?
  modelCustomName  String?
  /// The chosen `Model` row; the domain checks its provider is on the same list.
  modelId          String
  model            Model             @relation(fields: [modelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// No foreign key: the admin who chose it; `null` when ostra kept the current one.
  chosenByMemberId String?
  reason           ModelChoiceReason
  /// The upgrade found profiles naming this model on different providers: an admin confirms it.
  needsConfirm     Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, projectId, modelKey])
  @@unique([organizationId, modelKey], where: raw("\"projectId\" IS NULL"), map: "model_choice_one_per_default_list")
  @@map("model_choice")
}

enum ModelChoiceReason {
  admin
  kept
  upgrade
}

// ===========================================================================
// Milestone 4, several GitHub accounts (ticket 46, spec section 5.5, ADR 0065). Additive only.
// ===========================================================================

/// An installation of a connected App that an organization admin linked, or the App owner's own,
/// linked when seen (F-136). ostra mints a token, lists a repo and keeps a delivery only for a
/// `linked` one. Any other installation isn't a row: it waits on the GitHub page until an admin links it.
model CodeHostInstallation {
  id                String                   @id @default(uuid(7))
  organizationId    String
  connectionId      String
  connection        Connection               @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// The code host's ID of the installation.
  installationId    String
  /// The account it's on; `null` for a row the upgrade made, filled on the next read.
  accountId         String?
  accountLogin      String
  accountKind       InstallationAccountKind?
  state             InstallationState        @default(linked)
  /// No foreign key: the admin who linked it; `null` for the owner's own, or the upgrade's.
  linkedByMemberId  String?
  linkedAt          DateTime                 @default(now())
  removedAt         DateTime?
  /// No foreign key: kept by ID.
  removedByMemberId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  repos Repo[]

  @@unique([connectionId, installationId])
  /// The target of `Repo`'s composite key.
  @@unique([organizationId, connectionId, installationId])
  @@map("code_host_installation")
}

enum InstallationState {
  linked
  removed
}

enum InstallationAccountKind {
  organization
  user
}

// ===========================================================================
// Milestone 5: the fleet (spec section 5.3, ADR 0059, ADR 0060)
// ===========================================================================

/// One of an organization's three box sizes (F-095, ADR 0059): `small`, `medium` or `large`
/// (checked in the migration), each with the limits of the agent's container.
model BoxSize {
  id                String       @id @default(uuid(7))
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  cpuMillis         Int
  memoryMiB         Int
  /// The admin who last changed it; `null` for the defaults.
  updatedByMemberId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("box_size")
}

/// The organization's registry for snapshots (F-120, ADR 0060): one per organization. Its
/// credentials are secret store references, never the values.
model Registry {
  id                String       @id @default(uuid(7))
  organizationId    String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The registry's host (and port), such as `registry.example.com`.
  url               String
  /// The path images go under: `<url>/<repositoryPrefix>/<projectId>:<snapshotId>`.
  repositoryPrefix  String
  auth              RegistryAuth
  /// Secret store references for the push and the pull credential; `null` with `node` auth.
  pushSecretId      String?
  pullSecretId      String?
  /// The last check from the panel, and its result as the domain's `registryCheckResultSchema`.
  checkedAt         DateTime?
  checkResult       Json?
  updatedByMemberId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  snapshots Snapshot[]

  @@unique([id, organizationId])
  @@map("registry")
}

/// How a runner was installed (protocol minor 4): from npm, from the runner image, or from source.
enum RunnerInstall {
  npm
  image
  source
}

/// Why a box is still `creating` (F-093): no node yet, or its image is being pulled.
enum BoxWaitingReason {
  node
  image_pull
}

/// How a registry is signed in to (F-120): a username and token, or the node's own identity.
enum RegistryAuth {
  basic
  node
}

/// What built a snapshot (F-120): the host's Docker engine or a rootless BuildKit pod.
enum SnapshotBuilder {
  docker
  buildkit
}

// ---- milestone 7 (spec section 5.3) ----

/// A member's theme (F-082): `system` follows the browser's `prefers-color-scheme`.
enum ThemePreference {
  dark
  light
  system
}

// ---------- milestone 8 (ticket 04, spec section 5.3, ADR 0068, ADR 0069) ----------

/// An app process of an environment (F-140, ADR 0068): the project's own program, run from one of
/// its repos in a task's box, beside the environment's services. Parsed and checked by the
/// domain's `appProcessSchema`.
model AppProcess {
  id             String       @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  environmentId  String
  environment    Environment  @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Cascade)
  /// Lower-case letters, digits and dashes: it names `OSTRA_APP_<NAME>_URL`.
  name           String
  repoId         String
  repo           Repo         @relation(fields: [repoId, projectId], references: [id, projectId], onDelete: Cascade)
  /// Its folder in the repo's checkout, `.` for the root.
  folder         String       @default(".")
  /// The command that starts it and keeps running. Never logged.
  command        String
  port           Int
  readyKind      AppReadyKind
  /// The ready check's path (`http`) or command (`command`, never logged); `null` for `port`.
  readyValue     String?
  label          String
  /// The primary preview: at most one per environment (`app_process_one_primary`).
  primary        Boolean      @default(false)
  /// The native preview rewrites `Host` and `Origin` (Q304); off for an app that builds URLs from its host.
  hostRewrite    Boolean      @default(true)
  /// Its place in the list: the order the runner starts them in.
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([environmentId, name])
  @@unique([environmentId, port])
  @@unique([environmentId], where: raw("\"primary\""), map: "app_process_one_primary")
  @@map("app_process")
}

/// A screenshot or a recording of a task's running app (F-121, ADR 0068): a blob of the task, shown
/// in its thread at its place in the turn. Stored from the runner's `attachment.added`, once per
/// `attachmentId`.
model TaskAttachment {
  id             String            @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project           @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task              @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  /// The runner's ID of it, unique within the task.
  attachmentId   String
  kind           AttachmentKind
  blobId         String
  blob           Blob              @relation(fields: [blobId, organizationId], references: [id, organizationId], onDelete: Cascade)
  source         AttachmentSource
  targetKind     PreviewTargetKind
  /// The process's or the service's name; `null` for a port.
  targetName     String?
  port           Int?
  path           String
  width          Int
  height         Int
  /// A recording's length and frames; `null` for a screenshot.
  durationMs     Int?
  frameCount     Int?
  /// The agent's caption. Never logged.
  caption        String?
  browserName    String
  browserVersion String
  /// The turn it was taken in, by ID; `null` for a member's from the pane.
  turnId         String?
  /// The member who took it from the pane (`source` `member`).
  memberId       String?
  /// The refine draft image it was added to ("Add to draft", F-099), by ID.
  draftImageId   String?
  createdAt      DateTime          @default(now())

  @@unique([taskId, attachmentId])
  @@index([taskId, createdAt])
  @@map("task_attachment")
}

/// A port the agent announced in a task with `show_preview` (F-140, ADR 0068): scoped to the task.
/// "Keep it" turns it into an environment proposal.
model TaskPreview {
  id                String   @id @default(uuid(7))
  organizationId    String
  projectId         String
  project           Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId            String
  task              Task     @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  /// The preview's key (`port-<port>`), the same on every box of the task.
  key               String
  port              Int
  label             String
  path              String   @default("/")
  primary           Boolean  @default(false)
  announcedInTurnId String?
  /// The proposal "Keep it" made, by ID.
  keptProposalId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([taskId, key])
  @@map("task_preview")
}

/// A preview's level (F-142, ADR 0068): the project's members, or named people. With no row, the
/// level is `members`. Links are `PreviewLink` rows.
model PreviewAccess {
  id             String        @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId         String
  task           Task          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  key            String
  level          PreviewLevel  @default(members)
  setByMemberId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members PreviewAccessMember[]

  @@unique([taskId, key])
  @@unique([id, projectId])
  @@map("preview_access")
}

/// A named person of a preview's `named` level (F-142): they see that preview and nothing else of the task.
model PreviewAccessMember {
  id              String        @id @default(uuid(7))
  organizationId  String
  projectId       String
  project         Project       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  previewAccessId String
  previewAccess   PreviewAccess @relation(fields: [previewAccessId, projectId], references: [id, projectId], onDelete: Cascade)
  memberId        String
  member          Member        @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([previewAccessId, memberId])
  @@index([memberId])
  @@map("preview_access_member")
}

/// A link to a preview (F-142, ADR 0068): expiring, or public where an organization admin allows
/// it; watch-only unless it allows input. A bearer token, kept only as its SHA-256.
model PreviewLink {
  id                String          @id @default(uuid(7))
  organizationId    String
  projectId         String
  project           Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId            String
  task              Task            @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  key               String
  kind              PreviewLinkKind
  /// The token's SHA-256, lower-case hex. The token itself is shown once and never stored or logged.
  tokenHash         String          @unique
  allowInput        Boolean         @default(false)
  /// When it ends; `null` only for a `public` link (checked in the migration).
  expiresAt         DateTime?
  createdByMemberId String
  revokedAt         DateTime?
  revokedByMemberId String?
  /// Its first use, for its audit entry once, and its last.
  firstUsedAt       DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime        @default(now())

  views PreviewView[]
  codes PreviewCode[]

  @@unique([id, projectId])
  @@index([taskId, key])
  @@map("preview_link")
}

/// One opening of a preview (F-141, F-143, F-144): the browser view, a tunnel, the native preview or
/// `ostra preview`, by a member or a link. Its presence names the replica that holds the box's
/// preview connection, so other replicas forward to it (Q305).
model PreviewView {
  id               String           @id @default(uuid(7))
  organizationId   String
  projectId        String
  project          Project          @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskId           String
  task             Task             @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  key              String
  mode             PreviewViewMode
  openedByMemberId String?
  linkId           String?
  link             PreviewLink?     @relation(fields: [linkId, projectId], references: [id, projectId], onDelete: Cascade)
  leaseId          String?
  leaseEpoch       Int
  /// The internal address of the replica holding the box's preview connection (`OSTRA_CORE_REPLICA_URL`).
  replicaUrl       String?
  state            PreviewViewState @default(opening)
  openedAt         DateTime         @default(now())
  lastHeartbeatAt  DateTime         @default(now())
  closedAt         DateTime?
  /// Why its box refused its `preview.open` (`previewOpenRefusalSchema`): the pane's stream ends
  /// with it. `null` for a view its box didn't refuse. Only a closed view has one (`ostra:` check).
  refusal          String?
  /// A native view (ticket 26, F-144): the framing header core's proxy replaced on the app's answers,
  /// `x-frame-options` or `frame-ancestors`, the first time it did, for the pane's notice. `null`
  /// until it replaces one. The app's own header, never a cookie or a body.
  framingHeader    String?
  /// That header's value as the app sent it, at most 256 characters.
  framingValue     String?

  @@index([state, lastHeartbeatAt])
  @@index([taskId, key])
  @@map("preview_view")
}

/// A one-time code for the native preview's handshake, or a CLI tunnel's ticket (F-143, F-144):
/// single use, 60 s, bound to the member or the link, the task, the port and the lease epoch. Kept
/// only as its SHA-256; the code itself is never stored or logged.
model PreviewCode {
  id             String          @id @default(uuid(7))
  organizationId String
  projectId      String
  project        Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind           PreviewCodeKind
  /// The code's SHA-256, lower-case hex. Never logged.
  codeHash       String          @unique
  taskId         String
  task           Task            @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  key            String
  port           Int
  memberId       String?
  linkId         String?
  link           PreviewLink?    @relation(fields: [linkId, projectId], references: [id, projectId], onDelete: Cascade)
  leaseEpoch     Int
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime        @default(now())
  /// A CLI ticket's CLI session (ticket 23): core checks it again while the tunnel lasts, and ends
  /// the tunnel once it's revoked. `null` for a native preview's code.
  cliSessionId   String?
  cliSession     CliSession?     @relation(fields: [cliSessionId], references: [id], onDelete: Cascade)
  /// A native preview's code for a member (ticket 25, F-144): the panel's login session it was
  /// minted in (`AuthSession.id`, never its token), so the preview's cookie lasts no longer than
  /// that session and ends when it's signed out. `null` for a link's code and a CLI ticket. No
  /// foreign key: a code lives 60 s, and one whose session is gone is refused when it's redeemed.
  authSessionId  String?

  @@index([expiresAt])
  @@index([cliSessionId])
  @@map("preview_code")
}

/// A skill or an MCP server in an organization's library (F-145, ADR 0069), installed by reference
/// from a GitHub repo, a well-known URL or a registry, pinned and hashed. Removing it keeps the row.
model LibraryItem {
  id                  String                @id @default(uuid(7))
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind                LibraryItemKind
  name                String
  sourceKind          LibraryItemSourceKind
  /// Where it comes from, parsed by the domain's `librarySourceSchema`.
  source              Json
  /// Attached to every profile of the organization.
  everyProfile        Boolean               @default(false)
  /// An MCP server whose tools only read: plan mode may call them.
  readOnly            Boolean               @default(false)
  /// The version tasks get. One of this item's versions.
  currentVersionId    String?               @unique
  currentVersion      LibraryItemVersion?   @relation("LibraryItemCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  installedByMemberId String
  installedAt         DateTime              @default(now())
  removedAt           DateTime?
  removedByMemberId   String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  versions    LibraryItemVersion[]  @relation("LibraryItemVersions")
  profiles    AgentProfileLibraryItem[]
  suggestions LibrarySuggestion[]

  @@unique([id, organizationId])
  @@unique([organizationId, kind, name], where: raw("\"removedAt\" IS NULL"), map: "library_item_one_name")
  @@map("library_item")
}

/// One version of a library item (F-145, ADR 0069): its pin, its files or its server entry, and the
/// diff against the current one. An update waits as `available` until an admin accepts it.
model LibraryItemVersion {
  id                String              @id @default(uuid(7))
  organizationId    String
  itemId            String
  item              LibraryItem         @relation("LibraryItemVersions", fields: [itemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  number            Int
  state             LibraryVersionState
  /// The reference's ref, as asked (`#ref`), and the commit it resolved to.
  ref               String?
  commitSha         String?
  /// The `skills` CLI's hash of the skill's folder.
  computedHash      String?
  /// A skill's files: `[{ path, blobId, size, sha256, executable }]`. Their content is never logged.
  files             Json                @default("[]")
  /// A registry entry's version.
  registryVersion   String?
  /// A server's remote: its URL template and the headers it asks for, never a secret's value.
  serverEntry       Json?
  /// A server's inputs: plain values, and secret references for the secret ones. Never a secret's value; never logged.
  serverInputs      Json?
  /// The tools the test call listed.
  toolNames         Json                @default("[]")
  /// The server answered the test call with an OAuth challenge: it can't be attached yet (Q321).
  needsOAuth        Boolean             @default(false)
  /// Files added, removed and changed, or a server's changed fields, against the current version.
  diff              Json?
  fetchedAt         DateTime            @default(now())
  decidedByMemberId String?
  decidedAt         DateTime?
  createdAt         DateTime            @default(now())

  currentOf LibraryItem? @relation("LibraryItemCurrentVersion")

  @@unique([itemId, number])
  @@map("library_item_version")
}

/// A library item attached to a profile (F-145): its tasks get it at the item's current version.
model AgentProfileLibraryItem {
  id                 String       @id @default(uuid(7))
  organizationId     String
  profileId          String
  profile            AgentProfile @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: Cascade)
  itemId             String
  item               LibraryItem  @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  attachedByMemberId String
  attachedAt         DateTime     @default(now())

  @@unique([profileId, itemId])
  @@index([itemId])
  @@map("agent_profile_library_item")
}

/// A source an organization's library may install from (F-145, ADR 0069, Q322): a GitHub owner or
/// repo, a well-known host, or a registry and its namespace. Matched by these, never by a name.
model LibrarySource {
  id              String            @id @default(uuid(7))
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            LibrarySourceKind
  value           String
  /// A registry's namespace, such as `io.github.example`; `null` for the whole registry, and for the other kinds.
  namespace       String?
  addedByMemberId String?
  createdAt       DateTime          @default(now())

  @@unique([organizationId, kind, value, namespace])
  @@unique([organizationId, kind, value], where: raw("namespace IS NULL"), map: "library_source_one_without_namespace")
  @@map("library_source")
}

/// A member's suggestion of something to install (F-145): an admin installs or dismisses it.
model LibrarySuggestion {
  id                String                 @id @default(uuid(7))
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId          String
  /// The reference as the member wrote it, parsed again by the domain's `libraryReferenceSchema` when acted on.
  reference         String
  /// The member's note. Never logged.
  note              String?
  state             LibrarySuggestionState @default(open)
  decidedByMemberId String?
  decidedAt         DateTime?
  itemId            String?
  item              LibraryItem?           @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: NoAction)
  createdAt         DateTime               @default(now())

  @@index([organizationId, state])
  @@map("library_suggestion")
}

/// How the runner knows an app process is ready (F-140): an HTTP path, a command, or the port.
enum AppReadyKind {
  http
  command
  port
}

/// A screenshot or a recording (F-121).
enum AttachmentKind {
  screenshot
  recording
}

/// Who took a picture (F-121): the agent, ostra after a turn, or a member from the pane.
enum AttachmentSource {
  agent
  after_turn
  member
}

/// What a preview or a picture shows: an app process, an announced port, or a service.
enum PreviewTargetKind {
  process
  port
  service
}

/// A preview's level below its links (F-142).
enum PreviewLevel {
  members
  named
}

/// A preview link's kind (F-142).
enum PreviewLinkKind {
  expiring
  public
}

/// How a view was opened (F-141, F-143, F-144).
enum PreviewViewMode {
  stream
  tunnel
  native
  cli
}

/// A view's lifecycle (F-141): `opening` → `open` → `closed`.
enum PreviewViewState {
  opening
  open
  closed
}

/// A one-time code for the native preview's handshake, or a CLI tunnel's ticket.
enum PreviewCodeKind {
  enter
  cli_ticket
}

/// Why a lease's box runs (F-141, Q300): an agent turn, or the app alone ("Start the app").
enum LeasePurpose {
  turn
  app
}

/// A library item's kind (F-145).
enum LibraryItemKind {
  skill
  mcp_server
}

/// Where a library item comes from (F-145): a GitHub repo, a well-known URL, or a registry.
enum LibraryItemSourceKind {
  github
  well_known
  registry
}

/// A library source's kind (F-145, Q322): a GitHub owner or repo, a well-known host, or a registry.
enum LibrarySourceKind {
  github_owner
  github_repo
  well_known_host
  registry
}

/// A library item version's lifecycle (F-145): `available` → `current` | `dismissed`, `current` → `superseded`.
enum LibraryVersionState {
  current
  available
  superseded
  dismissed
}

/// A suggestion's lifecycle (F-145): `open` → `installed` | `dismissed`.
enum LibrarySuggestionState {
  open
  installed
  dismissed
}
