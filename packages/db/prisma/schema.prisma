  reopen
  message
  diff_comments
  update_branch
  pr_comment
  keep_working
  closing_turn
  automatic_round
  // Milestone 6 (F-105, F-012): a reviewer's "changes requested", a member's follow-up from Linear.
  changes_requested
  linear_follow_up
}

enum MemoryKind {
  convention
  command
  gotcha
  decision
  preference
  term
}

enum MemoryScope {
  organization
  project
}

enum MemoryNoteStatus {
  active
  archived
}

enum MemorySourceKind {
  member
  task
  diff_comment
  pr_comment
  proposal
  /// Milestone 6 (F-111): "Remember this" on an AI review's finding.
  ai_finding
}

enum ProposalState {
