{
  "name": "@ostra/protocol",
  "version": "0.0.0",
  "description": "Zod schemas for the runner protocol, agent events, the task spec and config",
  "license": "Apache-2.0",
  "author": "JoeyKhd (https://github.com/JoeyKhd), the maintainer of ostra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeyKhd/ostra.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --maxWorkers=4"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
