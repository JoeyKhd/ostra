{
  "name": "@ostra/adapter-model-endpoint",
  "version": "0.0.0",
  "description": "The model provider adapter: any base URL and token, in OpenAI-compatible or Anthropic Messages format, matched to the models.dev catalog",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --maxWorkers=4",
    "catalog:refresh": "node scripts/refresh-catalog.ts"
  },
  "dependencies": {
    "@ostra/adapter-sdk": "workspace:*",
    "@ostra/protocol": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.1.1"
  }
}
