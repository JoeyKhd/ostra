{
  "name": "spike-is-opencode-good-enough",
  "version": "0.0.0",
  "private": true,
  "description": "Spike 10: does OpenCode, on an ordinary model, turn realistic tickets into PRs a reviewer would merge?",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "spike": "node src/harness/spike.ts",
    "check:inputs": "node src/harness/check-inputs.ts",
    "runs": "node src/runner/cli.ts",
    "sheet": "node src/rating/make-sheet-cli.ts",
    "score": "node src/rating/score-cli.ts",
    "report": "node src/harness/report-cli.ts",
    "oracle": "node src/harness/oracle-cli.ts",
    "status": "node src/harness/status-table.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node ../../node_modules/eslint/bin/eslint.js --max-warnings 0 src test sample-repo vitest.config.ts eslint.config.js",
    "test": "vitest run",
    "clean": "node -e \"const fs=require('fs'),path=require('path'),os=require('os');for(const d of ['.runs',path.join(os.tmpdir(),'ostra-spike-10')])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "@opencode/cli": "2.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
