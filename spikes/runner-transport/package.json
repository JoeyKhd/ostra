{
  "name": "spike-runner-transport",
  "version": "0.0.0",
  "private": true,
  "description": "Milestone 0, spike 6: does the runner protocol lose nothing, through real networks, at the scale floor? Throwaway code.",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "check:inputs": "node src/check-inputs.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "spike": "tsc --noEmit -p tsconfig.json && node src/harness/spike.ts",
    "spike:quick": "tsc --noEmit -p tsconfig.json && node src/harness/spike.ts --quick",
    "spike:full-load": "tsc --noEmit -p tsconfig.json && node src/harness/spike.ts --only=load --full-load"
  },
  "dependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "8.23.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
