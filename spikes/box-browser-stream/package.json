{
  "name": "spike-box-browser-stream",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Milestone 8, ticket 07: the box's own headless browser streamed as JPEG frames through a relay shaped like core, with input coming back, on both carriers. Throwaway code.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "api": "node src/api/main.ts",
    "app": "vite --config app/vite.config.ts",
    "spike": "node src/harness/run.ts",
    "spike:quick": "node src/harness/run.ts --quick"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
