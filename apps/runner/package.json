{
  "name": "@ostra/runner",
  "version": "0.0.0",
  "description": "The ostra CLI: the pool runner, the sidecar, login and checkout (ADR 0046)",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "bin": {
    "ostra": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --maxWorkers=4",
    "pack:cli": "node src/pack/pack-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@ostra/adapter-executor-docker": "workspace:*",
    "@ostra/adapter-executor-host": "workspace:*",
    "@ostra/adapter-opencode": "workspace:*",
    "@ostra/adapter-sdk": "workspace:*",
    "@ostra/protocol": "workspace:*",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ostra/adapter-github": "workspace:*",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "vitest": "5.1.1"
  }
}
