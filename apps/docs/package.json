{
  "name": "@ostra/docs",
  "version": "0.0.0",
  "description": "The docs site: Fumadocs on Next.js, exported static to GitHub Pages (ADR 0063)",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./configuration-reference": "./src/lib/configuration-reference.ts"
  },
  "scripts": {
    "generate": "fumadocs-mdx",
    "dev": "next dev --port 3990",
    "build": "next build",
    "check:export": "vitest run --config vitest.export.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --ignore-pattern next-env.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "16.19.4",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.1.1"
  }
}
