{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": ["source.config.ts", "content/**", "markdown/**", "../../docs/**"],
      "outputs": [".source/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "../web/src/app/globals.css", "../../context/brand/app-targets/m7/light-home.md"]
    }
  }
}
