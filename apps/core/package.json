{
  "name": "@ostra/core",
  "version": "0.0.0",
  "description": "The runner gateway, webhooks and queue workers (ADR 0016, ADR 0045)",
  "private": true,
  "license": "LicenseRef-Sustainable-Use-1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing/document-fixtures": "./src/testing/document-fixtures.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
