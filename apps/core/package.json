    "@ostra/adapter-email-smtp": "workspace:*",
    "@ostra/adapter-github": "workspace:*",
    "@ostra/adapter-linear": "workspace:*",
    "@ostra/adapter-model-endpoint": "workspace:*",
    "@ostra/adapter-notify-panel": "workspace:*",
    "@ostra/adapter-notify-tracker": "workspace:*",
    "@ostra/adapter-opencode": "workspace:*",
    "@ostra/adapter-sdk": "workspace:*",
    "@ostra/adapter-secret-store-builtin": "workspace:*",
    "@ostra/db": "workspace:*",
    "@ostra/domain": "workspace:*",
    "@ostra/jobs": "workspace:*",
    "@ostra/protocol": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
