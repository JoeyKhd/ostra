# Secrets never live in this repo (AGENTS.md: they're kept in ~/.config/ostra-dev/).
# These patterns are a backstop against an accidental copy.
.env
.env.*
!.env.example
*.env
*.pem
*.key
keys/

# Installed agent skills: third-party, under their own licenses. Reinstall from skills-lock.json.
.agents/skills/
.claude/skills/
.claude/settings.local.json

# Brandkit records that hold account-specific Higgsfield paths
context/brand/kit/state.json
context/brand/kit/approve-logo.json
context/brand/kit/logo/candidates/result-*.json
context/brand/kit/logo/candidates/result-*.err

# The dev stack's data: the embedded Postgres cluster and the server's dev data (ticket 05)
.ostra-dev/

# The load test's runs: each step's results, logs and its throwaway Postgres (ticket 34)
.data/

# Prisma's generated client, rebuilt by `pnpm db:generate`
packages/db/src/generated/

# Tooling
node_modules/
.turbo/
.next/
.next-pseudo/
dist/
coverage/
*.log
# The release's dry-run logs are evidence kept in the repo (milestone 7's ticket 30).
!context/specs/m7-launch/demo/*.log
# Milestone 6's run records: the schedule hunt (ticket 37) and the Linear agent-mode harness (ticket 38).
!context/specs/m6-whole-team/demo/*.log
.env
.env.*
.DS_Store
Thumbs.db
